cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/cache-defaults")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/probe.cmake" [=[
cmake_minimum_required(VERSION 3.21)
include("${ROOT}/cmake/CpktDependencyArchiveCache.cmake")
if(EXPLICIT)
  set(CPKT_DEPENDENCY_CACHE "${EXPLICIT}")
endif()
cpkt_initialize_dependency_cache()
if(NOT CPKT_DEPENDENCY_CACHE STREQUAL EXPECTED)
  message(FATAL_ERROR "Wrong cache: ${CPKT_DEPENDENCY_CACHE} != ${EXPECTED}")
endif()
]=])
set(probe "${CMAKE_COMMAND}" "-DROOT=${CPKT_ROOT}" -P "${work}/probe.cmake")
# Explicit CMake value, then environment, then XDG, then HOME.
foreach(mode explicit environment xdg home)
  set(explicit "")
  set(environment "")
  set(xdg "${work}/xdg with spaces")
  set(home "${work}/home")
  if(mode STREQUAL "explicit")
    set(explicit "${work}/explicit")
    set(environment "${work}/environment")
    set(expected "${explicit}")
  elseif(mode STREQUAL "environment")
    set(environment "${work}/environment")
    set(expected "${environment}")
  elseif(mode STREQUAL "xdg")
    set(expected "${xdg}/cpkt/deps")
  else()
    set(xdg "")
    set(expected "${home}/.cache/cpkt/deps")
  endif()
  cpkt_test_command("${CMAKE_COMMAND}" -E env "CPKT_DEPENDENCY_CACHE=${environment}"
    "XDG_CACHE_HOME=${xdg}" "HOME=${home}" "${CMAKE_COMMAND}"
    "-DROOT=${CPKT_ROOT}" "-DEXPLICIT=${explicit}" "-DEXPECTED=${expected}" -P "${work}/probe.cmake")
endforeach()
cpkt_test_command("${CMAKE_COMMAND}" -E env --unset=CPKT_TOOLCHAIN_CACHE
  "XDG_CACHE_HOME=${work}/xdg with spaces" bash "${CPKT_ROOT}/scripts/cpkt-toolchains.sh" discover x86_64-linux-gnu)
if(NOT CPKT_TEST_OUTPUT MATCHES "cache=${work}/xdg with spaces/cpkt/toolchains(\n|$)"
    OR NOT CPKT_TEST_OUTPUT MATCHES "(^|\n)status=missing(\n|$)")
  message(FATAL_ERROR "Toolchain discovery did not use the XDG cpkt cache: ${CPKT_TEST_OUTPUT}")
endif()
if(EXISTS "${work}/xdg with spaces/cpkt")
  message(FATAL_ERROR "Read-only cache resolution created shared state")
endif()
