include("${CPKT_SOURCE}/cmake/CpktMutationPaths.cmake")
set(work "${CPKT_BINARY}/compression-metadata")
set(_stage_root "${work}/prefix")
cpkt_validate_mutation_paths("${_stage_root}" "${work}/source/CMakeLists.txt" "${work}/consumer/CMakeCache.txt")
file(MAKE_DIRECTORY "${_stage_root}/lib/pkgconfig" "${_stage_root}/include" "${work}/source")
set(_cpkt_static_library_suffix .a)
set(_cpkt_shared_library_suffix .so)
set(CPKT_TARGET_ID x86_64-linux-gnu)
set(CPKT_BUNDLE_VERSION 0.0.0)
# This fixture isolates package namespaces, not artifact identity/version gates.
function(cpkt_metadata_file operation path)
  cpkt_validate_mutation_paths("${path}")
  if(operation STREQUAL "MAKE_DIRECTORY")
    file(MAKE_DIRECTORY "${path}")
  elseif(operation STREQUAL "WRITE")
    file(WRITE "${path}" "${ARGV2}")
  else()
    message(FATAL_ERROR "Unexpected metadata operation: ${operation}")
  endif()
endfunction()
function(cpkt_write_config_version)
endfunction()
include("${CPKT_SOURCE}/cmake/compression_package_metadata.cmake")
file(WRITE "${work}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(codec_package_names C)
foreach(package CpktZstdFacade CpktLz4Facade CpktLzoFacade)
  find_package(${package} CONFIG REQUIRED PATHS "${CPKT_PREFIX}" NO_DEFAULT_PATH)
endforeach()
foreach(library zstd lz4 lzo)
  foreach(kind static shared)
    get_target_property(native cpkt::${library}_native_${kind} IMPORTED_LOCATION)
    get_target_property(facade cpkt::${library}_${kind} IMPORTED_LOCATION)
    if(native MATCHES "libcpkt_" OR NOT facade MATCHES "/libcpkt_${library}[.]")
      message(FATAL_ERROR "Native/facade namespace collision: ${library}/${kind}: ${native}; ${facade}")
    endif()
  endforeach()
endforeach()
]=])
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/consumer"
  "-DCPKT_PREFIX=${_stage_root}" "-DCMAKE_PREFIX_PATH=${_stage_root}"
  RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Codec package namespace test failed: ${out}${err}")
endif()
