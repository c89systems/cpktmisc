include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(nm "${CMAKE_ARGV3}")
set(readelf "${CMAKE_ARGV4}")
set(system "${CMAKE_ARGV5}")
set(compiler "${CMAKE_ARGV6}")
set(library "${CMAKE_ARGV7}")
set(private_header "${CMAKE_ARGV8}")
file(READ "${private_header}" private_text)
string(REGEX MATCHALL "cpkt_[A-Za-z0-9_]+[ \t\r\n]*\\(" private "${private_text}")
string(REGEX REPLACE "[ \t\r\n]*\\(" "" private "${private}")
list(REMOVE_DUPLICATES private)
set(includes "")
set(source "")
math(EXPR last "${CMAKE_ARGC}-1")
foreach(index RANGE 9 ${last})
  set(header "${CMAKE_ARGV${index}}")
  get_filename_component(parent "${header}" DIRECTORY)
  get_filename_component(include "${parent}" DIRECTORY)
  list(APPEND includes "-I${include}")
  string(APPEND source "#include \"${header}\"\n")
endforeach()
file(MAKE_DIRECTORY "${CPKT_SCRATCH}/export-checks")
string(SHA256 key "${library}")
file(WRITE "${CPKT_SCRATCH}/export-checks/${key}.c" "${source}")
cpkt_test_command("${compiler}" -E -P -x c -std=c99 ${includes} "${CPKT_SCRATCH}/export-checks/${key}.c")
string(REGEX MATCHALL "cpkt_opcua_[A-Za-z0-9_]+[ \t\r\n]*\\([ \t\r\n]*[^* \t\r\n]" declarations "${CPKT_TEST_OUTPUT}")
set(expected "")
foreach(declaration IN LISTS declarations)
  string(REGEX REPLACE "[ \t\r\n]*\\(.*$" "" name "${declaration}")
  list(APPEND expected "${name}")
endforeach()
string(REGEX MATCHALL "extern[ \t\r\n]+const[ \t\r\n]+cpkt_opcua_[A-Za-z0-9_]+[ \t\r\n*]+cpkt_opcua_[A-Za-z0-9_]+[ \t\r\n]*;" constants "${CPKT_TEST_OUTPUT}")
foreach(constant IN LISTS constants)
  string(REGEX MATCH "(cpkt_opcua_[A-Za-z0-9_]+)[ \t\r\n]*$" match "${constant}")
  # CMake list parsing removes the declaration's trailing semicolon.
  list(APPEND expected "${CMAKE_MATCH_1}")
endforeach()
if(system STREQUAL "Darwin")
  set(flags -g -m)
else()
  set(flags -g --defined-only)
endif()
cpkt_test_command("${nm}" ${flags} "${library}")
string(REPLACE "\n" ";" lines "${CPKT_TEST_OUTPUT}")
set(actual "")
set(seen_private "")
foreach(line IN LISTS lines)
  if(line MATCHES "[ \t]U[ \t]|\\(undefined\\)")
    continue()
  endif()
  if(NOT line MATCHES "[ \t]([A-Za-z_][A-Za-z0-9_]*)$")
    continue()
  endif()
  set(symbol "${CMAKE_MATCH_1}")
  if(system STREQUAL "Darwin")
    if(NOT line MATCHES " external ")
      continue()
    endif()
    string(REGEX REPLACE "^_" "" symbol "${symbol}")
  endif()
  if(symbol MATCHES "^_(init|fini)$")
    continue()
  endif()
  if(symbol IN_LIST private)
    if(NOT library MATCHES "[.]a$")
      message(FATAL_ERROR "Private helper escaped the shared-library boundary: ${symbol}")
    elseif(system STREQUAL "Darwin")
      if(NOT line MATCHES "private external ")
        message(FATAL_ERROR "Private helper has public visibility: ${symbol}")
      endif()
      list(APPEND seen_private "${symbol}")
    endif()
  elseif(symbol MATCHES "^cpkt_opcua_")
    list(APPEND actual "${symbol}")
  elseif(system STREQUAL "Darwin" OR line MATCHES "[ \t][TDBR][ \t]")
    message(FATAL_ERROR "Unexpected private definition in OPC UA facade: ${symbol}")
  endif()
endforeach()
if(library MATCHES "[.]a$" AND NOT system STREQUAL "Darwin")
  cpkt_test_command("${readelf}" -W -s "${library}")
  string(REPLACE "\n" ";" lines "${CPKT_TEST_OUTPUT}")
  foreach(line IN LISTS lines)
    if(line MATCHES "[ \t]([A-Za-z_][A-Za-z0-9_]*)$")
      set(symbol "${CMAKE_MATCH_1}")
      if(symbol IN_LIST private AND NOT line MATCHES "[ \t]UND[ \t]")
        if(NOT line MATCHES "[ \t]HIDDEN[ \t]")
          message(FATAL_ERROR "Private helper has public visibility: ${symbol}")
        endif()
        list(APPEND seen_private "${symbol}")
      endif()
    endif()
  endforeach()
endif()
foreach(list expected actual private seen_private)
  list(FILTER ${list} EXCLUDE REGEX "^$")
  list(REMOVE_DUPLICATES ${list})
  list(SORT ${list})
endforeach()
if(NOT actual STREQUAL expected)
  set(missing "${expected}")
  set(extra "${actual}")
  list(REMOVE_ITEM missing ${actual})
  list(REMOVE_ITEM extra ${expected})
  message(FATAL_ERROR "OPC UA export mismatch: missing=${missing}; extra=${extra}")
endif()
if(library MATCHES "[.]a$" AND NOT seen_private STREQUAL private)
  message(FATAL_ERROR "Missing private archive helpers: expected=${private}; actual=${seen_private}")
endif()
