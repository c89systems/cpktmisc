# Canonical input mutations for the real source generator, kept as fixture data.
function(generator_mutation path old new)
  list(LENGTH mutations index)
  set(mutation_${index}_path "${path}" PARENT_SCOPE)
  set(mutation_${index}_old "${old}" PARENT_SCOPE)
  set(mutation_${index}_new "${new}" PARENT_SCOPE)
  list(APPEND mutations "${index}")
  set(mutations "${mutations}" PARENT_SCOPE)
endfunction()
