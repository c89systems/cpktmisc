cmake_minimum_required(VERSION 3.21)
file(READ "${CPKT_ROOT}/src/sus.c" source)
function(body name output)
  string(REGEX MATCH "(static[ \t\r\n]+)?cpkt_sus_result[ \t\r\n]+${name}[ \t\r\n]*\\([^;{]*\\)[ \t\r\n]*\\{" signature "${source}")
  if(NOT signature)
    message(FATAL_ERROR "Missing SUS function body: ${name}")
  endif()
  string(FIND "${source}" "${signature}" start)
  string(LENGTH "${signature}" length)
  math(EXPR cursor "${start}+${length}")
  set(depth 1)
  while(depth GREATER 0)
    string(SUBSTRING "${source}" ${cursor} 1 char)
    if(char STREQUAL "{")
      math(EXPR depth "${depth}+1")
    elseif(char STREQUAL "}")
      math(EXPR depth "${depth}-1")
    endif()
    math(EXPR cursor "${cursor}+1")
  endwhile()
  math(EXPR length "${cursor}-${start}")
  string(SUBSTRING "${source}" ${start} ${length} result)
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
body(cpkt_sus_open_path local)
body(cpkt_sus_open_cached cached)
body(cpkt_sus_download_to_file download)
body(cpkt_sus_fetch_cached_file fetch)
if(local MATCHES "curl_|cpkt_sus_fetch_cached_file|cpkt_sus_download_to_file|source_url")
  message(FATAL_ERROR "The local model constructor must never acquire network content")
endif()
foreach(needle whisper_init_from_file_with_params "config->model_path")
  string(FIND "${local}" "${needle}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Local model constructor no longer owns local-path loading")
  endif()
endforeach()
foreach(name local cached fetch)
  if("${${name}}" MATCHES "curl_easy_perform")
    message(FATAL_ERROR "Network I/O escaped the private download function")
  endif()
endforeach()
foreach(needle curl_global_init curl_easy_perform)
  string(REGEX MATCHALL "${needle}" occurrences "${source}")
  list(LENGTH occurrences count)
  if(NOT count EQUAL 1 OR NOT download MATCHES "${needle}")
    message(FATAL_ERROR "${needle} must remain isolated in the download path")
  endif()
endforeach()
if(NOT cached MATCHES "cpkt_sus_fetch_cached_file" OR NOT fetch MATCHES "cpkt_sus_download_to_file"
    OR NOT fetch MATCHES "config->source_url" OR download MATCHES "fopen\\(path")
  message(FATAL_ERROR "Cached-model acquisition or descriptor ownership drifted")
endif()
