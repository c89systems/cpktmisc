include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(upstream "${CMAKE_ARGV3}")
set(facade "${CMAKE_ARGV4}")
set(library "${CMAKE_ARGV5}")
set(nm "${CMAKE_ARGV6}")
set(catalog "${CMAKE_ARGV7}")
file(READ "${upstream}" native)
string(REGEX MATCHALL "HPDF_EXPORT\\([^)]*\\)[ \t\r\n]*(HPDF_[A-Za-z0-9_]+)[ \t\r\n]*\\(" declarations "${native}")
set(expected "")
foreach(declaration IN LISTS declarations)
  string(REGEX MATCH "HPDF_EXPORT\\([^)]*\\)[ \t\r\n]*HPDF_([A-Za-z0-9_]+)[ \t\r\n]*\\(" match "${declaration}")
  set(name "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "([a-z0-9])([A-Z])" "\\1_\\2" name "${name}")
  string(REGEX REPLACE "([A-Z])([A-Z][a-z])" "\\1_\\2" name "${name}")
  string(TOLOWER "${name}" name)
  string(REPLACE "__" "_" name "${name}")
  list(APPEND expected "cpkt_pdf_${name}")
endforeach()
list(REMOVE_DUPLICATES expected)
list(LENGTH expected count)
if(NOT count EQUAL 290)
  message(FATAL_ERROR "Expected the pinned 290 libHaru functions, found ${count}")
endif()
file(READ "${facade}" header)
string(REGEX MATCHALL "cpkt_pdf_[A-Za-z0-9_]+[ \t\r\n]*\\(" declared "${header}")
string(REGEX REPLACE "[ \t\r\n]*\\(" "" declared "${declared}")
file(STRINGS "${catalog}" allowed REGEX "^cpkt_pdf_")
cpkt_test_command("${nm}" -D --defined-only "${library}")
string(REGEX MATCHALL "cpkt_pdf_[A-Za-z0-9_]+" actual "${CPKT_TEST_OUTPUT}")
foreach(list expected declared allowed actual)
  list(REMOVE_DUPLICATES ${list})
  list(SORT ${list})
endforeach()
if(NOT expected STREQUAL declared OR NOT expected STREQUAL allowed OR NOT expected STREQUAL actual)
  message(FATAL_ERROR "PDF declarations, catalog and exports do not match the pinned native API")
endif()
