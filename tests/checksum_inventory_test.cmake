cmake_minimum_required(VERSION 3.21)
set(work "${CPKT_SCRATCH}/checksum-inventory")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
set(sdk cpktmisc-0.2.1-x86_64-linux-gnu.tar.gz)
set(source cpktmisc-0.2.1.tar.gz)
set(previous cpktmisc-0.2.0-x86_64-linux-gnu.tar.gz)
set(other cpktmisc-0.2.10-arm64-apple-darwin-smoke-test.zip)
foreach(name IN ITEMS "${sdk}" "${source}" "${previous}" "${other}")
  file(WRITE "${work}/${name}" "fixture: ${name}\n")
  file(SHA256 "${work}/${name}" hash)
  set("hash_${name}" "${hash}")
endforeach()
file(WRITE "${work}/binary-CHECKSUMS" "${hash_${sdk}}  ${sdk}\n")
file(WRITE "${work}/release-CHECKSUMS" "${hash_${sdk}}  ${sdk}\n${hash_${source}}  ${source}\n")

function(check scope manifest files diagnostic)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DCPKT_BASE=${work}"
    "-DCPKT_MANIFEST=${work}/${manifest}-CHECKSUMS" "-DCPKT_FILES=${files}"
    "-DCPKT_SCOPE=${scope}" -DCPKT_VERSION=0.2.1
    -P "${CPKT_ROOT}/cmake/verify-checksums.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(diagnostic STREQUAL "")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Expected valid ${scope} inventory: ${output}${error}")
    endif()
  elseif(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${diagnostic}")
    message(FATAL_ERROR "Expected rejection /${diagnostic}/: ${output}${error}")
  endif()
endfunction()

# Other complete version names, including a numeric prefix collision, coexist
# with the candidate's source archive during a binary-only rehearsal.
check(binary binary "${sdk}" "")
check(release release "${sdk};${source}" "Stale/unlisted release-looking artifact")
foreach(name IN ITEMS "${previous}" "${other}")
  file(SHA256 "${work}/${name}" actual)
  if(NOT actual STREQUAL "${hash_${name}}")
    message(FATAL_ERROR "Warm verification changed unrelated artifact: ${name}")
  endif()
endforeach()
foreach(name cpktmisc-0.2.1-unexpected.tar.gz cpktmisc-unidentified.tar.gz)
  file(WRITE "${work}/${name}" "unlisted\n")
  check(binary binary "${sdk}" "Stale/unlisted release-looking artifact")
  file(REMOVE "${work}/${name}")
endforeach()
file(WRITE "${work}/${sdk}" "corrupt\n")
check(binary binary "${sdk}" "Checksum mismatch")
file(WRITE "${work}/${sdk}" "fixture: ${sdk}\n")
file(REMOVE "${work}/${previous}" "${work}/${other}")
check(release release "${sdk};${source}" "")
