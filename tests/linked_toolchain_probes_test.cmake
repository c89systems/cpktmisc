cmake_minimum_required(VERSION 3.21)
get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT CPKT_BINARY OR NOT CPKT_TARGET)
  message(FATAL_ERROR "Linked probes require the selected binary workspace and target")
endif()
set(work "${CPKT_BINARY}/linked-probes")
include("${root}/cmake/CpktMutationPaths.cmake")
cpkt_validate_mutation_paths("${work}/source/CMakeLists.txt" "${work}/${CPKT_TARGET}/CMakeCache.txt")
file(MAKE_DIRECTORY "${work}/source")
file(WRITE "${work}/source/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 3.21)
project(symbol_probes C)
include(CheckFunctionExists)
check_function_exists(printf HAS_PRINTF)
check_function_exists(_fseeki64 HAS_WINDOWS_SEEK)
if(NOT HAS_PRINTF OR HAS_WINDOWS_SEEK)
  message(FATAL_ERROR "Function probes accepted a missing symbol or rejected libc")
endif()
]=])
foreach(target IN ITEMS "${CPKT_TARGET}")
  if(target MATCHES "darwin$")
    set(toolchain "${root}/cmake/toolchains/arm64-apple-darwin.cmake")
  else()
    set(toolchain "${root}/cmake/CpktReadOnlyToolchain.cmake")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env "CPKT_RESOLVED_TARGET=${target}"
    "${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/${target}"
    "-DCMAKE_TOOLCHAIN_FILE=${toolchain}" -DCMAKE_TRY_COMPILE_TARGET_TYPE=EXECUTABLE
    RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${target} linked probes failed: ${out}${err}")
  endif()
endforeach()
