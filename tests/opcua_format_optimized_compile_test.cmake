include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(binary "${CMAKE_ARGV3}")
file(READ "${binary}/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count}-1")
set(found OFF)
foreach(index RANGE 0 ${last})
  string(JSON file GET "${commands}" ${index} file)
  if(NOT file STREQUAL "${binary}/generated/opcua/opcua_native_format.c")
    continue()
  endif()
  set(found ON)
  string(JSON command GET "${commands}" ${index} command)
  string(JSON directory GET "${commands}" ${index} directory)
  separate_arguments(arguments UNIX_COMMAND "${command}")
  set(filtered "")
  set(skip OFF)
  foreach(argument IN LISTS arguments)
    if(skip)
      set(skip OFF)
    elseif(argument MATCHES "^(-o|-MF|-MT|-MQ)$")
      set(skip ON)
    elseif(NOT argument MATCHES "^(-MD|-MMD|-MP)$")
      list(APPEND filtered "${argument}")
    endif()
  endforeach()
  file(MAKE_DIRECTORY "${binary}/formatter-check")
  execute_process(COMMAND ${filtered} -O3 -o "${binary}/formatter-check/formatter.o"
    WORKING_DIRECTORY "${directory}" RESULT_VARIABLE result ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Optimized formatter failed with configured warnings: ${error}")
  endif()
endforeach()
if(NOT found)
  message(FATAL_ERROR "Native formatter is missing from the compile database")
endif()
