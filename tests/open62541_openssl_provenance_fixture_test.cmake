include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(generator "${CMAKE_ARGV5}")
set(work "${CPKT_SCRATCH}/openssl-provenance-${generator}")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/source")
file(WRITE "${work}/source/probe.c" "int probe(void) { return 0; }\n")
file(WRITE "${work}/source/CMakeLists.txt" [=[cmake_minimum_required(VERSION 3.21)
project(openssl_provenance C)
set(OpenSSL_DIR "${PREFIX}/lib/cmake/OpenSSL" CACHE PATH "")
set(OPENSSL_USE_STATIC_LIBS "${STATIC}" CACHE BOOL "")
foreach(component ssl crypto)
  add_library(${component}_fixture SHARED probe.c)
  set_target_properties(${component}_fixture PROPERTIES OUTPUT_NAME ${component} LIBRARY_OUTPUT_DIRECTORY "${PREFIX}/lib")
endforeach()
add_library(open62541 SHARED probe.c)
target_link_libraries(open62541 PRIVATE "${SSL_LIBRARY}" "${CRYPTO_LIBRARY}")
]=])
set(prefix "${work}/bundled")
set(ssl "${prefix}/lib/libssl.so")
set(crypto "${prefix}/lib/libcrypto.so")
function(configure linkage ssl_library crypto_library)
  if(linkage STREQUAL "static")
    set(static ON)
  else()
    set(static OFF)
  endif()
  cpkt_test_command("${CMAKE_COMMAND}" -S "${work}/source" -B "${work}/build-${linkage}" -G "${generator}"
    "-DCMAKE_TOOLCHAIN_FILE=${CPKT_ROOT}/cmake/CpktReadOnlyToolchain.cmake"
    "-DPREFIX=${prefix}" "-DSTATIC=${static}" "-DSSL_LIBRARY=${ssl_library}" "-DCRYPTO_LIBRARY=${crypto_library}" ${ARGN})
endfunction()
set(check "${CMAKE_COMMAND}" "-DCPKT_OPEN62541_BUILD_ROOT=${work}" "-DCPKT_OPENSSL_PREFIX=${prefix}"
  -DCPKT_SHARED_LIBRARY_SUFFIX=.so -P "${CPKT_ROOT}/tests/open62541_openssl_provenance_test.cmake")
configure(static "${ssl}" "${crypto}")
cpkt_test_command("${CMAKE_COMMAND}" --build "${work}/build-static" --target ssl_fixture crypto_fixture)
configure(shared "${ssl}" "${crypto}")
cpkt_test_command(${check})
configure(shared "${work}/host/libssl.so" "${crypto}")
cpkt_test_failure("shared build does not link bundled" ${check})
configure(shared "${ssl}" "${prefix}/lib/libcrypto.a")
cpkt_test_failure("shared build does not link bundled" ${check})
configure(shared "${ssl}" "${crypto}" -DOPENSSL_USE_STATIC_LIBS=ON)
cpkt_test_failure("shared build did not select shared OpenSSL" ${check})
configure(shared "${ssl}" "${crypto}" -DOPENSSL_USE_STATIC_LIBS=OFF "-DOpenSSL_DIR=${work}/host/lib/cmake/OpenSSL")
cpkt_test_failure("shared uses OpenSSL config" ${check})
configure(shared "${ssl}" "${crypto}" "-DOpenSSL_DIR=${prefix}/lib/cmake/OpenSSL")
configure(static "${ssl}" "${crypto}" -DOPENSSL_USE_STATIC_LIBS=OFF)
cpkt_test_failure("static build did not select static OpenSSL" ${check})
configure(static "${ssl}" "${crypto}" -DOPENSSL_USE_STATIC_LIBS=ON)
cpkt_test_command(${check})
if(generator STREQUAL "Ninja")
  file(REMOVE "${work}/build-shared/build.ninja")
else()
  file(REMOVE "${work}/build-shared/CMakeFiles/open62541.dir/link.txt")
endif()
cpkt_test_failure("shared build plan is missing" ${check})
