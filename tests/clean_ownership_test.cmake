cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/clean-ownership")
file(REMOVE_RECURSE "${work}")
set(repo "${work}/repo with spaces")
file(MAKE_DIRECTORY "${repo}/scripts" "${repo}/cmake" "${work}/global/cpkt/deps")
foreach(script clean lifecycle-common mutation-paths require-host-bash)
  file(COPY_FILE "${CPKT_ROOT}/scripts/${script}.sh" "${repo}/scripts/${script}.sh")
endforeach()
file(COPY_FILE "${CPKT_ROOT}/cmake/lifecycle-info.cmake" "${repo}/cmake/lifecycle-info.cmake")
file(WRITE "${repo}/cmake/components.json" "{\"repository_group\":\"misc\"}")
file(WRITE "${work}/global/cpkt/deps/archive" "verified shared bytes\n")
foreach(path build/.hidden build/control/.operation.sock .cache/.hidden dist/.hidden)
  file(WRITE "${repo}/${path}" "disposable\n")
endforeach()
set(command "${CMAKE_COMMAND}" -E env "XDG_CACHE_HOME=${work}/global" "GROUP=all" "CMAKE=${CMAKE_COMMAND}"
  bash "${repo}/scripts/clean.sh")
cpkt_test_command(${command})
foreach(directory build .cache dist)
  if(EXISTS "${repo}/${directory}")
    message(FATAL_ERROR "Full clean preserved ${directory}")
  endif()
endforeach()
if(NOT EXISTS "${work}/global/cpkt/deps/archive" OR NOT EXISTS "${repo}/scripts/clean.sh")
  message(FATAL_ERROR "Clean removed borrowed caches or sources")
endif()
cpkt_test_command(${command})
# Reject redirection before removing any other generated root.
file(WRITE "${repo}/build/keep" "keep\n")
file(CREATE_LINK "${work}/global" "${repo}/.cache" SYMBOLIC)
cpkt_test_failure("symlink ancestor" ${command})
if(NOT EXISTS "${repo}/build/keep" OR NOT EXISTS "${work}/global/cpkt/deps/archive")
  message(FATAL_ERROR "Unsafe clean partially deleted owned or borrowed state")
endif()
file(REMOVE "${repo}/.cache")
cpkt_test_failure("graph/stage cleanup must remain under build"
  ${command} graph --path "${work}/global")
cpkt_test_failure("not owned by this repository" ${command} clean --group core)
