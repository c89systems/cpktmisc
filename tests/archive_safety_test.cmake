cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
include("${CPKT_ROOT}/cmake/gnu_tar.cmake")
cpkt_find_gnu_tar(tar)
set(work "${CPKT_SCRATCH}/archive-safety")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/input/sdk/lib")
file(WRITE "${work}/input/sdk/lib/sample" "safe\n")
file(WRITE "${work}/extract.cmake" [=[
cmake_minimum_required(VERSION 3.21)
include("${ROOT}/cmake/extract-release-archive.cmake")
cpkt_extract_release_archive("${ARCHIVE}" "${DESTINATION}" sdk TRUE)
]=])
set(archive "${work}/fixture.tar.gz")
set(extract "${CMAKE_COMMAND}" "-DROOT=${CPKT_ROOT}" "-DARCHIVE=${archive}"
  "-DDESTINATION=${work}/output" -P "${work}/extract.cmake")
cpkt_test_command(bash "${CPKT_ROOT}/scripts/archive.sh" "${work}/input/sdk" "${archive}")
cpkt_test_command(${extract})
file(WRITE "${work}/output/sentinel" "preserve on rejection\n")
# All member validation precedes extraction and deletion of existing scratch.
foreach(kind absolute_link escaping_link hard_link wrong_root duplicate traversal)
  file(REMOVE "${work}/input/sdk/lib/link")
  set(extra "")
  set(members sdk)
  set(expected "archive")
  if(kind STREQUAL "absolute_link")
    file(CREATE_LINK /etc/passwd "${work}/input/sdk/lib/link" SYMBOLIC)
    set(expected "Absolute archive link")
  elseif(kind STREQUAL "escaping_link")
    file(CREATE_LINK ../../../outside "${work}/input/sdk/lib/link" SYMBOLIC)
    set(expected "Escaping archive link")
  elseif(kind STREQUAL "hard_link")
    file(CREATE_LINK "${work}/input/sdk/lib/sample" "${work}/input/sdk/lib/link")
    set(expected "Unsupported or nondeterministic archive entry")
  elseif(kind STREQUAL "wrong_root")
    set(extra --transform=s,sdk,other,)
    set(expected "Unsafe or duplicate archive member")
  elseif(kind STREQUAL "duplicate")
    set(extra --hard-dereference)
    set(members sdk sdk/lib/sample)
    set(expected "Unsafe or duplicate archive member")
  else()
    set(extra --transform=s,sdk,../escape,)
    set(expected "Unsafe or duplicate archive member")
  endif()
  cpkt_test_command("${tar}" --create --format=gnu --sort=name --mtime=@0 --owner=0 --group=0
    --numeric-owner --gzip -f "${archive}" -C "${work}/input" ${extra} ${members})
  cpkt_test_failure("${expected}" ${extract})
  if(NOT EXISTS "${work}/output/sentinel")
    message(FATAL_ERROR "Rejected archive changed extraction destination")
  endif()
endforeach()
