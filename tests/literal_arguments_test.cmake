cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/cmake/CpktLiteralArguments.cmake")
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/literal-arguments")
file(MAKE_DIRECTORY "${work}")
function(round_trip value)
  cpkt_literal_argument(literal "${value}")
  file(WRITE "${work}/probe.cmake" "file(WRITE [==[${work}/result]==] ${literal})\n")
  cpkt_test_command("${CMAKE_COMMAND}" -P "${work}/probe.cmake")
  file(READ "${work}/result" actual)
  if(NOT actual STREQUAL value)
    message(FATAL_ERROR "Literal argument changed its bytes: '${value}' -> '${actual}'")
  endif()
endfunction()
round_trip("")
round_trip("\nleading newline")
round_trip("[built in to C library][v()]")
round_trip("foo]]bar]")
round_trip("semi;colon and $dollar and `backtick` and 'quote'")
round_trip("closing]=]=]")
