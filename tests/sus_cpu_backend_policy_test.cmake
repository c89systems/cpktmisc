cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
file(READ "${CPKT_ROOT}/cmake/components.json" inventory)
string(JSON record GET "${inventory}" components whisper)
string(JSON feature GET "${record}" package facades 0 features backend_capabilities)
if(NOT feature STREQUAL "CPKT_SUS_BACKEND_CAPABILITIES")
  message(FATAL_ERROR "SUS backend capability must come from its compiled configuration")
endif()
set(work "${CPKT_SCRATCH}/sus-feature-metadata")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/cmake" "${work}/build/fixture/misc/producer")
file(COPY_FILE "${CPKT_ROOT}/cmake/CpktPackageMetadata.cmake" "${work}/cmake/CpktPackageMetadata.cmake")
string(JSON count LENGTH "${record}" recipe_inputs)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON path GET "${record}" recipe_inputs ${index})
  get_filename_component(parent "${work}/${path}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(COPY_FILE "${CPKT_ROOT}/${path}" "${work}/${path}")
endforeach()
file(WRITE "${work}/cmake/components.json" "{\"components\":{\"whisper\":${record}}}")
file(WRITE "${work}/build/fixture/misc/producer/CMakeCache.txt" "CPKT_WHISPER_VERSION:STRING=v1.9.4\n")
file(WRITE "${work}/encode.cmake" [=[cmake_minimum_required(VERSION 3.21)
include("${CMAKE_SOURCE_DIR}/cmake/CpktPackageMetadata.cmake")
file(READ "${CMAKE_SOURCE_DIR}/cmake/components.json" CPKT_INVENTORY)
set(CPKT_GROUP misc)
set(CPKT_TARGET_ID fixture)
set(CPKT_ACTIVE_COMPONENTS whisper)
set(CPKT_SUS_BACKEND_CAPABILITIES cpu)
cpkt_package_component_metadata(metadata)
string(JSON capabilities GET "${metadata}" 0 features backend_capabilities)
if(NOT capabilities STREQUAL "cpu")
  message(FATAL_ERROR "Compiled CPU capability disappeared from package metadata")
endif()
]=])
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${work}/encode.cmake"
  WORKING_DIRECTORY "${work}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "SUS feature encoding failed: ${error}")
endif()
