include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(compiler "${CMAKE_ARGV4}")
set(platform "${CMAKE_ARGV5}")
set(work "${CPKT_SCRATCH}/public-api-fixture")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/native/open62541" "${work}/facade/cpkt")
set(native "typedef struct { void *context; void (*hook)(void *context); } UA_TestPlugin;\nvoid UA_test(void);\n")
set(facade "typedef struct { void *context; void (*hook)(void *context); } cpkt_opcua_TestPlugin;\nvoid cpkt_opcua_test(void);\n")
file(WRITE "${work}/native/open62541/public.h" "${native}")
file(WRITE "${work}/facade/cpkt/opcua_types.h" "${facade}")
file(WRITE "${work}/facade/opcua_types_metadata.inc" "/* No schema types in this fixture. */\n")
set(contract [=[{"functions":{"UA_test":{"declaration":"void UA_test ( void )","state":"bound","binding":"cpkt_opcua_test"}},"types":{"UA_TestPlugin":{"declaration":"typedef struct { void * context ; void ( * hook ) ( void * context ) ; } UA_TestPlugin","state":"bound","binding":"cpkt_opcua_TestPlugin"}},"variables":{}}]=])
file(WRITE "${work}/contract.json" "${contract}")
find_program(python python3 REQUIRED)
set(command "${python}" "${CPKT_ROOT}/tools/opcua/public_api.py" --compiler "${compiler}" --platform "${platform}"
  --native-include "${work}/native" --facade-include "${work}/facade" --generated-include "${work}/facade"
  --contract "${work}/contract.json" --report "${work}/report.json")
set(complete "${CMAKE_COMMAND}" "-DCPKT_REPORT=${work}/report.json" -P "${CPKT_ROOT}/tests/opcua_public_api_contract_test.cmake")
cpkt_test_command(${command})
cpkt_test_command(${complete})
string(JSON pending SET "${contract}" functions UA_test state "\"pending\"")
file(WRITE "${work}/contract.json" "${pending}")
cpkt_test_command(${command})
cpkt_test_failure("Public C89 coverage is incomplete" ${complete})
file(WRITE "${work}/contract.json" "${contract}")
foreach(case new_api changed_signature missing_binding missing_record_field native_escape unknown_state)
  file(WRITE "${work}/native/open62541/public.h" "${native}")
  file(WRITE "${work}/facade/cpkt/opcua_types.h" "${facade}")
  set(rules "${contract}")
  if(case STREQUAL "new_api")
    file(APPEND "${work}/native/open62541/public.h" "void UA_new(void);\n")
    set(error "Unclassified public functions")
  elseif(case STREQUAL "changed_signature")
    string(REPLACE "UA_test(void)" "UA_test(int changed)" changed "${native}")
    file(WRITE "${work}/native/open62541/public.h" "${changed}")
    set(error "Changed public functions declaration")
  elseif(case STREQUAL "missing_binding")
    string(REPLACE "cpkt_opcua_test" "cpkt_opcua_other" changed "${facade}")
    file(WRITE "${work}/facade/cpkt/opcua_types.h" "${changed}")
    set(error "Missing C89 binding")
  elseif(case STREQUAL "missing_record_field")
    string(REPLACE "void (*hook)(void *context);" "" changed "${facade}")
    file(WRITE "${work}/facade/cpkt/opcua_types.h" "${changed}")
    set(error "Missing C89 record members")
  elseif(case STREQUAL "native_escape")
    string(JSON rules SET "${rules}" functions UA_test binding "\"cpkt_opcua_server_native\"")
    file(APPEND "${work}/facade/cpkt/opcua_types.h" "void cpkt_opcua_server_native(void);\n")
    set(error "Native escape hatch")
  else()
    string(JSON rules SET "${rules}" functions UA_test state "\"silently_skipped\"")
    set(error "Unknown coverage state")
  endif()
  file(WRITE "${work}/contract.json" "${rules}")
  cpkt_test_failure("${error}" ${command})
endforeach()
