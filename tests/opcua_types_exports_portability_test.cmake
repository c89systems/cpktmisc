include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(compiler "${CMAKE_ARGV5}")
set(work "${CPKT_SCRATCH}/export-tools")
file(MAKE_DIRECTORY "${work}")
file(WRITE "${work}/private.h" "void cpkt_bridge_helper(void);\n")
file(WRITE "${work}/public.h" "void cpkt_opcua_hello(void);\nextern const cpkt_opcua_DataType *cpkt_opcua_table;\n#ifdef __linux__\nvoid cpkt_opcua_linux_only(void);\n#endif\n")
file(WRITE "${work}/symbols" "#!/bin/sh\ncase \"$1 $2\" in\n '-W -s') cat '${work}/visibility';;\n '-g -m'|'-g --defined-only') cat '${work}/output';;\n *) exit 1;;\nesac\n")
file(CHMOD "${work}/symbols" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
foreach(system Linux Darwin)
  if(system STREQUAL "Darwin")
    set(extra_flags "-U__linux__ -D__APPLE__")
    set(public "object.o:\n                 (undefined) external _UA_Server_new\n00000000 (__TEXT,__text) external _cpkt_opcua_hello\n00000020 (__DATA,__const) external _cpkt_opcua_table\n")
    set(helper "00000030 (__TEXT,__text) private external _cpkt_bridge_helper\n")
    set(shared .dylib)
  else()
    set(extra_flags -D__linux__)
    set(public "object.o:\n00000000 T cpkt_opcua_hello\n00000020 D cpkt_opcua_table\n00000040 T cpkt_opcua_linux_only\n                 U UA_Server_new\n")
    set(helper "00000030 T cpkt_bridge_helper\n")
    set(shared .so)
  endif()
  file(WRITE "${work}/compiler" "#!/bin/sh\nexec '${compiler}' ${extra_flags} \"$@\"\n")
  file(CHMOD "${work}/compiler" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  set(hidden "1: 00000030 4 FUNC GLOBAL HIDDEN 1 cpkt_bridge_helper\n")
  foreach(case public archive leak missing visible foreign extra mismatch)
    set(symbols "${public}")
    set(visibility "${hidden}")
    set(suffix "${shared}")
    set(error "")
    if(case STREQUAL "archive")
      set(suffix .a)
      string(APPEND symbols "${helper}")
    elseif(case STREQUAL "leak")
      string(APPEND symbols "${helper}")
      set(error "Private helper escaped")
    elseif(case STREQUAL "missing")
      set(suffix .a)
      set(visibility "")
      set(error "Missing private archive helpers")
    elseif(case STREQUAL "visible")
      set(suffix .a)
      string(REPLACE "private external" "external" helper_visible "${helper}")
      string(APPEND symbols "${helper_visible}")
      string(REPLACE "HIDDEN" "DEFAULT" visibility "${hidden}")
      set(error "Private helper has public visibility")
    elseif(case STREQUAL "foreign" OR case STREQUAL "extra")
      if(case STREQUAL "foreign")
        set(name UA_private)
        set(error "Unexpected private definition")
      else()
        set(name cpkt_opcua_unexpected)
        set(error "export mismatch")
      endif()
      if(system STREQUAL "Darwin")
        string(APPEND symbols "00000040 (__TEXT,__text) external _${name}\n")
      else()
        string(APPEND symbols "00000040 T ${name}\n")
      endif()
    elseif(case STREQUAL "mismatch")
      string(REPLACE "cpkt_opcua_hello" "cpkt_opcua_wrong" symbols "${symbols}")
      set(error "export mismatch")
    endif()
    file(WRITE "${work}/output" "${symbols}")
    file(WRITE "${work}/visibility" "${visibility}")
    set(command "${CMAKE_COMMAND}" -P "${CPKT_ROOT}/tests/opcua_types_exports_test.cmake"
      "${work}/symbols" "${work}/symbols" "${system}" "${work}/compiler" "${work}/facade${suffix}" "${work}/private.h" "${work}/public.h")
    if(error)
      cpkt_test_failure("${error}" ${command})
    else()
      cpkt_test_command(${command})
    endif()
  endforeach()
endforeach()
