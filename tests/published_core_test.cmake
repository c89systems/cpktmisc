cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/published-core")
file(REMOVE_RECURSE "${work}")
set(repo "${work}/repo with spaces")
set(target x86_64-linux-gnu)
set(name cpkt-1.2.3-${target})
set(sdk "${work}/${name}")
file(MAKE_DIRECTORY "${repo}/cmake" "${repo}/scripts" "${repo}/dependencies"
  "${sdk}/include" "${sdk}/share/cpkt/packages" "${sdk}/lib")
foreach(module CpktPublishedCore CpktCoreImports CpktSDKValidate CpktDependencyArchiveCache CpktMutationPaths core-dependency extract-release-archive gnu_tar lifecycle-info)
  file(COPY_FILE "${CPKT_ROOT}/cmake/${module}.cmake" "${repo}/cmake/${module}.cmake")
endforeach()
foreach(script core-dependency lifecycle-common mutation-paths require-host-bash)
  file(COPY_FILE "${CPKT_ROOT}/scripts/${script}.sh" "${repo}/scripts/${script}.sh")
endforeach()
file(WRITE "${repo}/cmake/components.json"
  "{\"repository_group\":\"misc\",\"components\":{\"zlib\":{\"external\":\"cpkt\",\"directory\":\"zlib\",\"package\":{\"version_variable\":\"CPKT_ZLIB_VERSION\"}}}}")
file(COPY_FILE "${CPKT_ROOT}/Makefile" "${repo}/Makefile")
file(COPY_FILE "${CPKT_ROOT}/CMakePresets.json" "${repo}/CMakePresets.json")
file(WRITE "${sdk}/include/sample.h" "int sample(void);\n")
file(WRITE "${sdk}/lib/libsample.so.1" "fixture library\n")
file(CREATE_LINK libsample.so.1 "${sdk}/lib/libsample.so" SYMBOLIC)
set(files "")
foreach(path include/sample.h lib/libsample.so.1)
  file(CHMOD "${sdk}/${path}" PERMISSIONS OWNER_READ OWNER_WRITE GROUP_READ WORLD_READ)
  file(SHA256 "${sdk}/${path}" sha)
  string(APPEND files "${separator}{\"mode\":\"0644\",\"path\":\"${path}\",\"sha256\":\"${sha}\",\"type\":\"file\"}")
  set(separator ,)
endforeach()
string(APPEND files ",{\"path\":\"lib/libsample.so\",\"target\":\"libsample.so.1\",\"type\":\"symlink\"}")
set(before "{\"components\":[{\"name\":\"zlib\",\"version\":\"9.8.7\"}],\"files\":[${files}],\"group\":\"core\",\"libc\":\"gnu\",\"macos_deployment_target\":null,")
set(after "\"release_version\":\"1.2.3\",\"requires_core\":null,\"schema_version\":1,\"target_id\":\"${target}\"}")
string(SHA256 id "${before}${after}")
set(manifest "${before}\"package_id\":\"${id}\",${after}")
file(WRITE "${sdk}/share/cpkt/packages/core.json" "${manifest}")
cpkt_test_command(bash "${CPKT_ROOT}/scripts/archive.sh" "${sdk}" "${work}/${name}.tar.gz")
file(SHA256 "${work}/${name}.tar.gz" digest)
set(cache "${work}/cache")
file(MAKE_DIRECTORY "${cache}/archives/sha256/${digest}")
file(COPY_FILE "${work}/${name}.tar.gz" "${cache}/archives/sha256/${digest}/renamed-archive.tar.gz")
set(pin "{\"schema_version\":1,\"repository\":\"c89systems/cpkt\",\"version\":\"1.2.3\",\"targets\":{\"${target}\":{\"url\":\"https://github.com/c89systems/cpkt/releases/download/v1.2.3/${name}.tar.gz\",\"sha256\":\"${digest}\",\"package_id\":\"${id}\"}}}")
file(WRITE "${repo}/dependencies/cpkt.json" "${pin}")
set(command "${CMAKE_COMMAND}" -E env "CPKT_DEPENDENCY_CACHE=${cache}" "CMAKE=${CMAKE_COMMAND}"
  bash "${repo}/scripts/core-dependency.sh" --target "${target}")
set(installed "${repo}/.cache/cpkt/${target}/install")
set(validate "${CMAKE_COMMAND}" "-DCPKT_REPO_ROOT=${repo}" "-DCPKT_CORE_TARGET=${target}"
  -DCPKT_CORE_ACTION=validate -P "${repo}/cmake/core-dependency.cmake")
cpkt_test_failure("Missing regular SDK manifest" ${validate})
cpkt_test_command(${command})
cpkt_test_command(${validate})
file(WRITE "${work}/versions.cmake" [=[
cmake_minimum_required(VERSION 3.21)
include("${ROOT}/cmake/CpktPublishedCore.cmake")
include("${ROOT}/cmake/CpktCoreImports.cmake")
file(READ "${ROOT}/cmake/components.json" CPKT_INVENTORY)
cpkt_validate_published_core("${ROOT}" x86_64-linux-gnu "${ROOT}/.cache/cpkt/x86_64-linux-gnu/install" manifest)
set(CPKT_ZLIB_VERSION 0.0.0 CACHE STRING "Producer default")
cpkt_load_core_versions("${manifest}")
if(NOT CPKT_ZLIB_VERSION STREQUAL "9.8.7")
  message(FATAL_ERROR "Imported component version came from a producer default")
endif()
]=])
cpkt_test_command("${CMAKE_COMMAND}" "-DROOT=${repo}" -P "${work}/versions.cmake")
if(NOT IS_SYMLINK "${repo}/.cache/deps/${target}/zlib/install"
    OR NOT EXISTS "${installed}/lib/libsample.so")
  message(FATAL_ERROR "Core acquisition did not publish the installed closure")
endif()
# An already validated SDK does not need an archive or a reachable origin.
file(REMOVE_RECURSE "${cache}")
cpkt_test_command(${command})
cpkt_test_command("${CMAKE_COMMAND}" -E env "CPKT_DEPENDENCY_CACHE=${cache}" "CMAKE=${CMAKE_COMMAND}"
  make --no-print-directory -C "${repo}" deps-core PRESET=debug GROUP=all)
cpkt_test_failure("not owned by this repository" "${CMAKE_COMMAND}" -E env "CPKT_DEPENDENCY_CACHE=${cache}"
  make --no-print-directory -C "${repo}" deps-core PRESET=debug GROUP=core)
if(EXISTS "${cache}")
  message(FATAL_ERROR "Warm prerequisite unnecessarily acquired an archive")
endif()
file(WRITE "${installed}/include/sample.h" "corrupt\n")
cpkt_test_failure("SDK payload differs" ${validate})
# Bad pins fail before acquisition, preserving all installed state.
string(JSON bad_pin SET "${pin}" targets "${target}" url "\"https://invalid.example/core.tar.gz\"")
file(WRITE "${repo}/dependencies/cpkt.json" "${bad_pin}")
cpkt_test_failure("Invalid published core archive URL" ${command})
file(READ "${installed}/include/sample.h" remaining)
if(NOT remaining STREQUAL "corrupt\n" OR EXISTS "${cache}")
  message(FATAL_ERROR "Rejected core pin mutated installed/shared state")
endif()
file(WRITE "${repo}/dependencies/cpkt.json" "${pin}")
file(MAKE_DIRECTORY "${cache}/archives/sha256/${digest}")
file(COPY_FILE "${work}/${name}.tar.gz" "${cache}/archives/sha256/${digest}/${name}.tar.gz")
cpkt_test_command(${command})
cpkt_test_command(${validate})
# Manifest identity remains bound to the selected published package.
string(REPEAT "0" 64 wrong_id)
string(JSON bad_pin SET "${pin}" targets "${target}" package_id "\"${wrong_id}\"")
file(WRITE "${repo}/dependencies/cpkt.json" "${bad_pin}")
cpkt_test_failure("Published core package ID" ${validate})
cpkt_test_failure("Published core package ID" ${command})
file(READ "${installed}/include/sample.h" remaining)
if(NOT remaining STREQUAL "int sample(void);\n")
  message(FATAL_ERROR "Failed staged validation replaced the installed SDK")
endif()
file(GLOB leftovers "${repo}/build/core-acquisition/${target}/extract.*")
if(leftovers)
  message(FATAL_ERROR "Failed prerequisite acquisition left extraction scratch: ${leftovers}")
endif()
file(WRITE "${repo}/dependencies/cpkt.json" "${pin}")
cpkt_test_failure("Unsupported imported core target"
  "${CMAKE_COMMAND}" "-DCPKT_REPO_ROOT=${repo}" -DCPKT_CORE_TARGET=../escape
  -DCPKT_CORE_ACTION=acquire -P "${repo}/cmake/core-dependency.cmake")
file(CREATE_LINK "${cache}" "${work}/redirected-cache" SYMBOLIC)
cpkt_test_failure("symlink ancestor" "${CMAKE_COMMAND}" -E env
  "CPKT_DEPENDENCY_CACHE=${work}/redirected-cache" bash "${repo}/scripts/core-dependency.sh" --target "${target}")
cpkt_test_failure("global cpkt cache" "${CMAKE_COMMAND}" -E env
  "CPKT_DEPENDENCY_CACHE=/tmp/cpktmisc-undeclared-cache" bash "${repo}/scripts/core-dependency.sh" --target "${target}")
