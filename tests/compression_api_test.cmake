# Independent native declaration inventory. CMake/CTest owns assertions;
# Clang and jq supply parsed source data, never build or release decisions.
include("${CPKT_SOURCE}/cmake/CpktMutationPaths.cmake")
set(work "${CPKT_BINARY}/api-coverage/${CPKT_LIBRARY}")
cpkt_validate_mutation_paths("${work}/native.c" "${work}/native.json" "${work}/public.c")
file(MAKE_DIRECTORY "${work}")
set(defines "")
if(CPKT_LIBRARY STREQUAL "ffi")
  set(headers ffi.h)
  set(family "^ffi_")
  set(constants "^(FFI_|ffi_type_)")
elseif(CPKT_LIBRARY STREQUAL "archive")
  set(headers archive.h archive_entry.h)
  set(family "^(archive_|la_)")
  set(constants "^(ARCHIVE_|AE_)")
elseif(CPKT_LIBRARY STREQUAL "zstd")
  set(headers zstd.h zdict.h zstd_errors.h)
  set(family "^(ZSTD|ZDICT)_")
  set(constants "^(ZSTD|ZDICT)_")
  set(defines "#define ZSTD_STATIC_LINKING_ONLY\n#define ZDICT_STATIC_LINKING_ONLY\n")
elseif(CPKT_LIBRARY STREQUAL "lzma")
  set(headers lzma.h)
  set(family "^lzma_")
  set(constants "^(LZMA_|lzma_)")
elseif(CPKT_LIBRARY STREQUAL "lz4")
  set(headers lz4.h lz4hc.h lz4frame.h lz4frame_static.h lz4file.h)
  set(family "^(LZ4|blockSizeID_t$|blockMode_t$|frameType_t$|contentChecksum_t$)")
  set(constants "^LZ4")
  set(defines "#define LZ4_STATIC_LINKING_ONLY\n#define LZ4_HC_STATIC_LINKING_ONLY\n#define LZ4F_STATIC_LINKING_ONLY\n#define LZ4F_ENABLE_OBSOLETE_ENUMS\n")
elseif(CPKT_LIBRARY STREQUAL "lzo")
  set(headers lzo/lzo1.h lzo/lzo1a.h lzo/lzo1b.h lzo/lzo1c.h lzo/lzo1f.h
    lzo/lzo1x.h lzo/lzo1y.h lzo/lzo1z.h lzo/lzo2a.h lzo/lzo_asm.h lzo/lzoutil.h)
  set(family "^(lzo_|lzo[12]|_+lzo_)")
  set(constants "^(LZO|lzo_)")
elseif(CPKT_LIBRARY STREQUAL "yaml")
  set(headers yaml.h)
  set(family "^yaml_")
  set(native_c89 TRUE)
elseif(CPKT_LIBRARY STREQUAL "bzip2")
  set(headers bzlib.h)
  set(family "^BZ2_")
  set(native_c89 TRUE)
else()
  message(FATAL_ERROR "Unknown public API coverage family: ${CPKT_LIBRARY}")
endif()
foreach(header IN LISTS headers)
  string(APPEND defines "#include <${header}>\n")
endforeach()
file(WRITE "${work}/native.c" "${defines}")
set(arguments "${CPKT_CLANG_ARGUMENTS}")
list(TRANSFORM arguments REPLACE "^--clang-argument=" "")
if(CPKT_CLANG MATCHES "apple-darwin")
  # osxcross injects linker options even for -fsyntax-only. Suppress only
  # unused command-line options, retaining all public C89 diagnostics.
  list(APPEND arguments -Qunused-arguments)
endif()
execute_process(COMMAND "${CPKT_CLANG}" ${arguments} -std=c99 -Wno-deprecated-declarations
  -I "${CPKT_NATIVE_INCLUDE}" -fsyntax-only -Xclang -ast-dump=json "${work}/native.c"
  OUTPUT_FILE "${work}/native.json" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Native ${CPKT_LIBRARY} API parse failed: ${error}")
endif()
find_program(jq jq REQUIRED)
if(native_c89)
  execute_process(COMMAND "${CPKT_CLANG}" ${arguments} -std=c89 -pedantic-errors -Wall -Wextra -Werror
    -I "${CPKT_NATIVE_INCLUDE}" -fsyntax-only "${work}/native.c"
    RESULT_VARIABLE status ERROR_VARIABLE error)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Native ${CPKT_LIBRARY} header requires a C89 facade: ${error}")
  endif()
  file(WRITE "${work}/public.c" "${defines}")
else()
  file(WRITE "${work}/public.c" "#include <cpkt/${CPKT_LIBRARY}.h>\n")
endif()
set(bindings "")
foreach(kind functions types variables)
  if(kind STREQUAL "functions")
    set(declaration FunctionDecl)
    set(extra "")
  elseif(kind STREQUAL "types")
    set(declaration TypedefDecl)
    set(extra "| select((.name | endswith(\"__\")) | not)")
  else()
    set(declaration VarDecl)
    set(extra "| select((.name | startswith(\"lzo_cta__\")) | not)")
  endif()
  execute_process(COMMAND "${jq}" -c --arg family "${family}"
    "[.inner[] | select(.kind == \"${declaration}\" and (.name // \"\" | test($family))) ${extra} | .name] | unique | sort"
    "${work}/native.json" OUTPUT_VARIABLE native OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT native_c89)
    if(kind STREQUAL "types")
      set(expression ".types | sort")
    else()
      set(expression ".${kind} | keys | sort")
    endif()
    execute_process(COMMAND "${jq}" -c "${expression}" "${CPKT_REPORT}"
      OUTPUT_VARIABLE public OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
    if(NOT native STREQUAL public)
      message(FATAL_ERROR "Incomplete ${CPKT_LIBRARY} ${kind}:\nnative=${native}\nfacade=${public}")
    endif()
  endif()
  string(JSON count LENGTH "${native}")
  if(kind STREQUAL "functions" AND count LESS 1)
    message(FATAL_ERROR "Empty ${CPKT_LIBRARY} public function inventory")
  endif()
  message(STATUS "${CPKT_LIBRARY}: ${count} public ${kind}")
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON name GET "${native}" ${index})
      if(native_c89)
        set(binding "${name}")
      else()
        set(binding "cpkt_${CPKT_LIBRARY}_${name}")
        if(kind STREQUAL "variables")
          string(APPEND binding "_ref")
        endif()
      endif()
      if(kind STREQUAL "types")
        file(APPEND "${work}/public.c" "extern ${binding} *cpkt_type_probe_${index};\n")
      else()
        file(APPEND "${work}/public.c" "typedef char cpkt_${kind}_probe_${index}[sizeof(&${binding}) ? 1 : -1];\n")
      endif()
      if(NOT kind STREQUAL "types")
        list(APPEND bindings "${binding}")
      endif()
    endforeach()
  endif()
endforeach()
if(native_c89)
  set(public_source "${work}/public.c")
  set(public_includes -I "${CPKT_NATIVE_INCLUDE}")
else()
  string(TOUPPER "${CPKT_LIBRARY}" upper)
  set(prefix "CPKT_${upper}_")
  # Read native macros independently of the generator report. Header guards,
  # visibility/configuration probes and compiler integer-selection helpers
  # have no consumer operation. All other family macros must be available.
  execute_process(COMMAND "${CPKT_CLANG}" ${arguments} -std=c99 -I "${CPKT_NATIVE_INCLUDE}"
    -E -dM "${work}/native.c" OUTPUT_VARIABLE macros COMMAND_ERROR_IS_FATAL ANY)
  string(REGEX MATCHALL "#define [A-Za-z_][A-Za-z_0-9]*" macro_names "${macros}")
  set(macro_count 0)
  foreach(macro IN LISTS macro_names)
    string(REPLACE "#define " "" name "${macro}")
    if(NOT name MATCHES "${constants}" OR name MATCHES "(_H(_|$)|STATIC_LINKING_ONLY$)"
        OR name MATCHES "^FFI_(64_BIT_MAX|LONG_LONG_MAX)$")
      continue()
    endif()
    file(APPEND "${work}/public.c" "#ifndef ${prefix}${name}\n#error Missing public macro ${name}\n#endif\n")
    math(EXPR macro_count "${macro_count} + 1")
  endforeach()
  # Compile enum-value and record-member probes derived from the native AST,
  # including records whose 64-bit fields require a different facade layout.
  execute_process(COMMAND "${jq}" -r --arg family "${family}" --arg constants "${constants}"
    --arg prefix "${prefix}" --arg type_prefix "cpkt_${CPKT_LIBRARY}_"
    -f "${CPKT_SOURCE}/tests/compression_api_probes.jq" "${work}/native.json"
    OUTPUT_VARIABLE probes COMMAND_ERROR_IS_FATAL ANY)
  file(APPEND "${work}/public.c" "${probes}\n")
  if(CPKT_LIBRARY STREQUAL "lzma")
    file(APPEND "${work}/public.c"
      "cpkt_lzma_lzma_stream cpkt_stream_initializer_probe = CPKT_LZMA_LZMA_STREAM_INIT;\n")
  endif()
  set(public_source "${work}/public.c")
  set(public_includes -I "${CPKT_SOURCE}/include" -I "${CPKT_BINARY}/generated/${CPKT_LIBRARY}/include")
  message(STATUS "${CPKT_LIBRARY}: ${macro_count} public macros; enum values and record fields probed")
endif()
execute_process(COMMAND "${CPKT_CLANG}" ${arguments} -std=c89 -pedantic-errors -Wall -Wextra -Werror
  ${public_includes} -fsyntax-only "${public_source}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Public ${CPKT_LIBRARY} header is not strict C89: ${error}")
endif()
execute_process(COMMAND "${CPKT_CLANG}" ${arguments} -x c++ -std=c++98 -pedantic-errors -Wall -Wextra -Werror
  ${public_includes} -fsyntax-only "${public_source}" RESULT_VARIABLE status ERROR_VARIABLE error)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "Public ${CPKT_LIBRARY} header is not C++ compatible: ${error}")
endif()
# Every public operation must be usable from both installed linkage modes.
# Do not infer availability from declarations or the generator's export catalog.
foreach(kind STATIC SHARED)
  if(CPKT_SYSTEM STREQUAL "Darwin" OR CPKT_CLANG MATCHES "apple-darwin")
    set(nm_options -g -U)
  elseif(kind STREQUAL "SHARED")
    set(nm_options -D -g --defined-only)
  else()
    set(nm_options -g --defined-only)
  endif()
  execute_process(COMMAND "${CPKT_NM}" ${nm_options} "${CPKT_${kind}}"
    OUTPUT_VARIABLE symbols ERROR_VARIABLE error RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot inventory ${CPKT_LIBRARY} ${kind}: ${error}")
  endif()
  foreach(binding IN LISTS bindings)
    if(NOT symbols MATCHES "[ \t]_?${binding}(@[^ \n]+)?([\r\n]|$)")
      message(FATAL_ERROR "Missing ${CPKT_LIBRARY} ${kind} public binding: ${binding}")
    endif()
  endforeach()
endforeach()
