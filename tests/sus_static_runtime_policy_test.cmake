cmake_minimum_required(VERSION 3.21)
file(READ "${CPKT_ROOT}/cmake/components.json" inventory)
string(JSON owned GET "${inventory}" components whisper package owned_patterns)
if(NOT owned MATCHES "lib/cpkt-cxx/\\*")
  message(FATAL_ERROR "Whisper must own its selected static C++ runtime payload")
endif()
foreach(name cpkt_cmake_sus_facade cpkt_sus_mixed_cxx)
  string(JSON links GET "${inventory}" installed_consumers "${name}" link_contains_linux)
  foreach(archive libstdc++.a libgcc.a)
    string(FIND "${links}" "@prefix/lib/cpkt-cxx/${archive}" found)
    if(found LESS 0)
      message(FATAL_ERROR "${name} lacks a delivered static runtime assertion for ${archive}")
    endif()
  endforeach()
endforeach()
string(JSON final_link GET "${inventory}" installed_consumers cpkt_sus_mixed_cxx c_final_link)
if(NOT final_link)
  message(FATAL_ERROR "Mixed C++ consumer must prove the C final-link metadata closure")
endif()
