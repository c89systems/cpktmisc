include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
file(READ "${CPKT_SCRATCH}/CMakeCache.txt" cache)
string(REGEX MATCH "CMAKE_CROSSCOMPILING_EMULATOR:STRING=([^\n]*)" match "${cache}")
set(runner "${CMAKE_MATCH_1}")
cpkt_test_command(${runner} "${CPKT_SCRATCH}/cpkt_sus_catalog_metadata")
file(READ "${CPKT_ROOT}/data/sus-model-catalog.tsv" expected)
if(NOT CPKT_TEST_OUTPUT STREQUAL expected)
  message(FATAL_ERROR "Delivered catalog metadata differs from the compiled facade API")
endif()
