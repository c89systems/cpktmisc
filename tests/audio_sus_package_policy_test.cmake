cmake_minimum_required(VERSION 3.21)
file(READ "${CPKT_ROOT}/cmake/components.json" inventory)
foreach(component miniaudio whisper)
  string(JSON owner GET "${inventory}" components "${component}" group)
  if(NOT owner STREQUAL "misc")
    message(FATAL_ERROR "Audio/speech payload escaped misc ownership")
  endif()
endforeach()
foreach(file LICENSE PROVENANCE.md)
  if(NOT EXISTS "${CPKT_ROOT}/docs/third_party/kblab-whisper-models/${file}")
    message(FATAL_ERROR "Missing KBLab license or provenance")
  endif()
endforeach()
string(JSON files GET "${inventory}" groups misc package files)
string(FIND "${files}" "docs/sus-model-catalog.tsv" catalog)
if(catalog LESS 0)
  message(FATAL_ERROR "The installed SDK must deliver the curated catalog metadata")
endif()
string(JSON consumers GET "${inventory}" installed_consumers)
string(FIND "${consumers}" "@prefix/lib/libcpktaudio.a" audio_link)
if(audio_link LESS 0)
  message(FATAL_ERROR "Speech package consumers must prove their public audio closure")
endif()
