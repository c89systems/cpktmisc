include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(upstream "${CMAKE_ARGV4}")
get_filename_component(parent "${upstream}/../.." ABSOLUTE)
set(work "${CPKT_SCRATCH}/opcua-generator-check")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}")
find_program(python python3 REQUIRED)
set(generator "${CPKT_ROOT}/tools/opcua/generate.py")
foreach(name one two)
  cpkt_test_command("${python}" "${generator}" --upstream "${upstream}" --output "${work}/${name}")
endforeach()
file(GLOB first_files RELATIVE "${work}/one" "${work}/one/cpkt/*.h" "${work}/one/*.inc" "${work}/one/opcua_native*")
foreach(file IN LISTS first_files)
  file(SHA256 "${work}/one/${file}" first)
  file(SHA256 "${work}/two/${file}" second)
  if(NOT first STREQUAL second)
    message(FATAL_ERROR "Source generation is nondeterministic: ${file}")
  endif()
  file(READ "${work}/one/${file}" content)
  string(FIND "${content}" "${CPKT_ROOT}" private)
  if(NOT private LESS 0)
    message(FATAL_ERROR "Generated public bytes contain a workstation path: ${file}")
  endif()
endforeach()
file(COPY "${parent}/include" "${parent}/share" DESTINATION "${work}/mutant")
include("${CPKT_ROOT}/tests/opcua-generator-mutations.cmake")
foreach(index IN LISTS mutations)
  set(path "${work}/mutant/include/open62541/${mutation_${index}_path}")
  file(READ "${path}" original)
  string(FIND "${original}" "${mutation_${index}_old}" position)
  if(position LESS 0)
    message(FATAL_ERROR "Pinned generator fixture is stale: ${mutation_${index}_path}: ${mutation_${index}_old}")
  endif()
  string(LENGTH "${mutation_${index}_old}" length)
  math(EXPR after "${position}+${length}")
  string(SUBSTRING "${original}" 0 ${position} before)
  string(SUBSTRING "${original}" ${after} -1 tail)
  file(WRITE "${path}" "${before}${mutation_${index}_new}${tail}")
  execute_process(COMMAND "${python}" "${generator}" --upstream "${work}/mutant/share/open62541"
    --output "${work}/rejected" RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err)
  file(WRITE "${path}" "${original}")
  if(status EQUAL 0)
    message(FATAL_ERROR "Generator accepted changed public input ${index}: ${mutation_${index}_path}: ${mutation_${index}_old}")
  endif()
endforeach()
file(READ "${work}/mutant/share/open62541/generate_datatypes.py" original)
string(REPLACE "args = parser.parse_args()" "args = None" changed "${original}")
file(WRITE "${work}/mutant/share/open62541/generate_datatypes.py" "${changed}")
cpkt_test_failure("Upstream generator changed" "${python}" "${generator}"
  --upstream "${work}/mutant/share/open62541" --output "${work}/changed-hook")
if(EXISTS "${work}/changed-hook/cpkt/opcua_types.h")
  message(FATAL_ERROR "Failed generation published a public header")
endif()
