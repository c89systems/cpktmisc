cmake_minimum_required(VERSION 3.21)
set(CPKT_TARGET_ID "${CPKT_TARGET}")
include("${CPKT_SOURCE}/cmake/extract-release-archive.cmake")
include("${CPKT_SOURCE}/cmake/CpktMiscValidate.cmake")
include("${CPKT_SOURCE}/cmake/CpktPublishedCore.cmake")
include("${CPKT_SOURCE}/cmake/package_inspection.cmake")
include("${CPKT_SOURCE}/tests/privacy_scan.cmake")
cpkt_extract_release_archive("${CPKT_ARCHIVE}" "${CPKT_PREFIX}"
  "cpktmisc-${CPKT_VERSION}-${CPKT_TARGET}" TRUE)
set(core "${CPKT_SOURCE}/.cache/cpkt/${CPKT_TARGET}/install")
cpkt_validate_published_core("${CPKT_SOURCE}" "${CPKT_TARGET}" "${core}" core_manifest)
file(READ "${CPKT_PREFIX}/share/cpkt/packages/misc.json" manifest)
string(JSON count LENGTH "${manifest}" files)
set(owned "share/cpkt/packages/misc.json")
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON path GET "${manifest}" files ${index} path)
  list(APPEND owned "${path}")
endforeach()

# Compare shipped facade identities and imports with the declared public ABI,
# independently of the manifest generated from the installed bytes.
include("${CPKT_SOURCE}/cmake/CpktABIVersions.cmake")
file(READ "${CPKT_SOURCE}/cmake/components.json" inventory)
string(JSON count LENGTH "${inventory}" components)
math(EXPR last "${count}-1")
foreach(index RANGE 0 ${last})
  string(JSON component MEMBER "${inventory}" components ${index})
  string(JSON owner GET "${inventory}" components "${component}" group)
  if(NOT owner STREQUAL "misc")
    continue()
  endif()
  string(JSON facade_count LENGTH "${inventory}" components "${component}" package facades)
  if(NOT facade_count)
    continue()
  endif()
  math(EXPR facade_last "${facade_count}-1")
  foreach(facade_index RANGE 0 ${facade_last})
    string(JSON facade GET "${inventory}" components "${component}" package facades ${facade_index})
    string(JSON name ERROR_VARIABLE missing GET "${facade}" output_name)
    if(missing)
      string(JSON name GET "${facade}" target)
    endif()
    string(JSON variable GET "${facade}" abi_version_variable)
    if(CPKT_TARGET MATCHES "darwin$")
      set(library "${CPKT_PREFIX}/lib/lib${name}.dylib")
      set(CPKT_OTOOL "${CPKT_TOOL}")
      cpkt_assert_darwin_install_name("${library}" "@rpath/lib${name}.${${variable}}.dylib" "${name}")
    else()
      set(library "${CPKT_PREFIX}/lib/lib${name}.so")
      set(CPKT_READELF "${CPKT_TOOL}")
      cpkt_assert_elf_soname("${library}" "lib${name}.so.${${variable}}" "${name}")
      string(JSON forbidden_count ERROR_VARIABLE missing LENGTH "${facade}" forbidden_needed)
      if(NOT missing AND forbidden_count GREATER 0)
        math(EXPR forbidden_last "${forbidden_count}-1")
        foreach(entry RANGE 0 ${forbidden_last})
          string(JSON forbidden GET "${facade}" forbidden_needed ${entry})
          cpkt_assert_elf_lacks_needed("${library}" "${forbidden}" "${name}")
        endforeach()
      endif()
    endif()
    string(JSON catalog ERROR_VARIABLE missing GET "${facade}" export_catalog)
    if(NOT missing)
      if(catalog MATCHES "^@generated/([^/]+)/exports[.]txt$")
        set(api "${CMAKE_MATCH_1}")
        # Derive declarations from the final shipped header independently of
        # the build generator's catalog. No checkout build state is consulted.
        file(STRINGS "${CPKT_PREFIX}/include/cpkt/${api}.h" declarations)
        set(expected "")
        foreach(declaration IN LISTS declarations)
          if(NOT declaration MATCHES "^[ \t]*(typedef|#|/|[*])" AND
              declaration MATCHES "[ *](cpkt_[A-Za-z0-9_]+)[(].*[)][;]$")
            list(APPEND expected "${CMAKE_MATCH_1}")
          endif()
        endforeach()
        if(NOT expected)
          message(FATAL_ERROR "No public declarations in ${api} shipped header")
        endif()
        list(REMOVE_DUPLICATES expected)
        list(SORT expected)
        list(JOIN expected "\n" contents)
        set(catalog "${CPKT_PREFIX}/../${api}.exports.txt")
        file(WRITE "${catalog}" "${contents}\n")
      else()
        set(catalog "${CPKT_SOURCE}/${catalog}")
      endif()
      cpkt_assert_dynamic_exports_equal("${library}" "${catalog}" "${name}")
    else()
      string(JSON policy ERROR_VARIABLE missing GET "${facade}" export_policy)
      if(NOT missing)
        cpkt_assert_dynamic_exports_match("${library}" "${policy}" "${name}")
      endif()
    endif()
  endforeach()
endforeach()
file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${CPKT_PREFIX}" "${CPKT_PREFIX}/*")
list(SORT files)
list(SORT owned)
if(NOT files STREQUAL owned)
  message(FATAL_ERROR "Archive payload differs from its manifest inventory")
endif()
get_filename_component(work "${CPKT_PREFIX}" DIRECTORY)
set(CPKT_TARGET_ID "${CPKT_TARGET}")
set(CPKT_EXPECTED_VERSION "${CPKT_VERSION}")
_cpkt_misc_validate_prefix("${CPKT_PREFIX}" misc)
foreach(field package_id release_version target_id)
  string(JSON expected GET "${manifest}" core_build_pin "${field}")
  string(JSON actual GET "${core_manifest}" "${field}")
  if(NOT expected STREQUAL actual)
    message(FATAL_ERROR "SDK prerequisite mismatch: ${field}")
  endif()
endforeach()
# Reject republished core payload even if it was included in misc's inventory.
string(JSON core_count LENGTH "${core_manifest}" files)
math(EXPR core_last "${core_count}-1")
foreach(index RANGE 0 ${core_last})
  string(JSON path GET "${core_manifest}" files ${index} path)
  if(path IN_LIST owned)
    message(FATAL_ERROR "Misc archive contains core-owned payload: ${path}")
  endif()
endforeach()
set(CPKT_ROOT "${CPKT_SOURCE}")
cpkt_assert_tree_has_no_private_traces("${CPKT_PREFIX}" "SDK")
if(CPKT_TARGET MATCHES "^aarch64")
  set(machine AArch64)
elseif(CPKT_TARGET MATCHES "^armhf")
  set(machine ARM)
else()
  set(machine "(X86-64|x86-64)")
endif()
foreach(relative IN LISTS files)
  set(file "${CPKT_PREFIX}/${relative}")
  if(IS_SYMLINK "${file}")
    continue()
  endif()
  file(STRINGS "${file}" private_traces REGEX "/home/|/Users/|/private/tmp/")
  if(private_traces)
    message(FATAL_ERROR "Private or test-only payload in ${relative}")
  endif()
  file(READ "${file}" magic LIMIT 4 HEX)
  if(magic STREQUAL "7f454c46" OR (CPKT_TARGET MATCHES "-linux-" AND relative MATCHES "\\.a$"))
    execute_process(COMMAND "${CPKT_TOOL}" -h "${file}"
      RESULT_VARIABLE result OUTPUT_VARIABLE header ERROR_VARIABLE error)
    string(REGEX MATCHALL "Machine:[^\n]+" machines "${header}")
    if(NOT result EQUAL 0 OR NOT machines)
      message(FATAL_ERROR "Wrong ELF architecture: ${relative}\n${error}")
    endif()
    foreach(actual_machine IN LISTS machines)
      if(NOT actual_machine MATCHES "${machine}")
        message(FATAL_ERROR "Wrong ELF archive member architecture: ${relative}: ${actual_machine}")
      endif()
    endforeach()
    set(CPKT_READELF "${CPKT_TOOL}")
    if(magic STREQUAL "7f454c46")
      cpkt_assert_elf_runtime_metadata_file_relocatable("${file}" "${relative}")
      cpkt_assert_elf_lacks_needed("${file}" "libpslog[^]]*" "${relative}")
    endif()
  elseif(CPKT_TARGET MATCHES "darwin$" AND magic STREQUAL "cffaedfe")
    execute_process(COMMAND "${CPKT_TOOL}" -hv "${file}" RESULT_VARIABLE result OUTPUT_VARIABLE header)
    if(NOT result EQUAL 0 OR NOT header MATCHES "ARM64")
      message(FATAL_ERROR "Wrong Mach-O architecture: ${relative}")
    endif()
    set(CPKT_OTOOL "${CPKT_TOOL}")
    cpkt_assert_darwin_dylib_relocatable("${file}" "${relative}")
    cpkt_assert_darwin_deployment_target("${file}" "15.0" "${relative}")
  endif()
endforeach()
