cmake_minimum_required(VERSION 3.21)
include("${CPKT_SOURCE}/tests/test-command.cmake")
set(work "${CPKT_WORK}/core-import-check")
file(REMOVE_RECURSE "${work}")
file(MAKE_DIRECTORY "${work}/source" "${work}/foreign")
file(WRITE "${work}/foreign/libz.a" "foreign core library\n")
file(WRITE "${work}/source/CMakeLists.txt" [=[cmake_minimum_required(VERSION 3.21)
project(core_import_check C)
# This checks target metadata and imports without compiling SDK libraries.
set(CMAKE_SYSTEM_NAME "")
set(CMAKE_SYSTEM_PROCESSOR "")
list(PREPEND CMAKE_PREFIX_PATH "${MISC_ROOT}" "${CORE_ROOT}")
list(APPEND CMAKE_FIND_ROOT_PATH "${MISC_ROOT}" "${CORE_ROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
find_package(CpktMisc CONFIG REQUIRED)
if(FOREIGN_LIBRARY)
  add_library(ZLIB::ZLIB STATIC IMPORTED)
  set_target_properties(ZLIB::ZLIB PROPERTIES IMPORTED_LOCATION "${FOREIGN_LIBRARY}")
endif()
cpkt_misc_assert_targets()
]=])
set(configure "${CMAKE_COMMAND}" -G Ninja -S "${work}/source" "-DMISC_ROOT=${CPKT_PREFIX}"
  "-DCORE_ROOT=${CPKT_CORE_PREFIX}" "-DCPKT_TARGET_ID=${CPKT_TARGET}")
cpkt_test_command(${configure} -B "${work}/valid")
cpkt_test_failure("Existing target ZLIB::ZLIB imports SDK library" ${configure} -B "${work}/foreign-import"
  "-DFOREIGN_LIBRARY=${work}/foreign/libz.a")
