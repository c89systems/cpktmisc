include("${CMAKE_CURRENT_LIST_DIR}/test-context.cmake")
set(command "")
math(EXPR last "${CMAKE_ARGC}-1")
foreach(index RANGE 4 ${last})
  list(APPEND command "${CMAKE_ARGV${index}}")
endforeach()
execute_process(COMMAND ${command} RESULT_VARIABLE status OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 25)
if(NOT status EQUAL 0 OR NOT out STREQUAL "[test] OPC UA logging through libpslog passed\n" OR NOT err STREQUAL "")
  message(FATAL_ERROR "Custom OPC UA logger emitted default output or failed: ${status}\n${out}${err}")
endif()
