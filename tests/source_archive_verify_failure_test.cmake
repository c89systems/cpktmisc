cmake_minimum_required(VERSION 3.21)
include("${CPKT_ROOT}/tests/test-command.cmake")
set(work "${CPKT_SCRATCH}/source-archive-errors")
file(REMOVE_RECURSE "${work}")
set(source "${work}/cpktmisc-1.2.3")
file(MAKE_DIRECTORY "${source}")
foreach(required CMakeLists.txt CMakePresets.json Makefile LICENSE)
  file(WRITE "${source}/${required}" "fixture\n")
endforeach()
file(WRITE "${source}/VERSION" "1.2.3\n")
set(manifest "CMakeLists.txt\nCMakePresets.json\nLICENSE\nMakefile\nRELEASE_MANIFEST\nVERSION\n")
file(WRITE "${source}/RELEASE_MANIFEST" "${manifest}")
set(archive "${work}/source.tar.gz")
set(check "${CMAKE_COMMAND}" "-DCPKT_SOURCE=${CPKT_ROOT}" "-DCPKT_ARCHIVE=${archive}"
  "-DCPKT_PREFIX=${work}/extracted" -DCPKT_VERSION=1.2.3 -P "${CPKT_ROOT}/tests/source/archive_test.cmake")
cpkt_test_command(bash "${CPKT_ROOT}/scripts/archive.sh" "${source}" "${archive}")
cpkt_test_command(${check})
foreach(invalid version missing extra duplicate)
  file(WRITE "${source}/VERSION" "1.2.3\n")
  file(WRITE "${source}/RELEASE_MANIFEST" "${manifest}")
  file(WRITE "${source}/LICENSE" "fixture\n")
  file(REMOVE "${source}/extra")
  if(invalid STREQUAL "version")
    file(WRITE "${source}/VERSION" "1.2.4\n")
    set(expected "Source release version mismatch")
  elseif(invalid STREQUAL "missing")
    file(REMOVE "${source}/LICENSE")
    set(expected "exact extracted inventory")
  elseif(invalid STREQUAL "extra")
    file(WRITE "${source}/extra" "unexpected\n")
    set(expected "exact extracted inventory")
  else()
    file(APPEND "${source}/RELEASE_MANIFEST" "LICENSE\n")
    set(expected "Duplicate source manifest entries")
  endif()
  cpkt_test_command(bash "${CPKT_ROOT}/scripts/archive.sh" "${source}" "${archive}")
  cpkt_test_failure("${expected}" ${check})
endforeach()
