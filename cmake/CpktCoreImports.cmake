# The caller passes JSON from native published-core byte/pin validation.
macro(cpkt_load_core_versions manifest)
  string(JSON _core_component_count LENGTH "${manifest}" components)
  math(EXPR _core_component_last "${_core_component_count} - 1")
  string(JSON _inventory_count LENGTH "${CPKT_INVENTORY}" components)
  math(EXPR _inventory_last "${_inventory_count} - 1")
  foreach(_index RANGE 0 ${_inventory_last})
    string(JSON _component MEMBER "${CPKT_INVENTORY}" components ${_index})
    string(JSON _external ERROR_VARIABLE _absent GET "${CPKT_INVENTORY}" components "${_component}" external)
    if(_absent)
      continue()
    endif()
    set(_matches 0)
    foreach(_core_index RANGE 0 ${_core_component_last})
      string(JSON _name GET "${manifest}" components ${_core_index} name)
      if(_name STREQUAL _component)
        math(EXPR _matches "${_matches} + 1")
        string(JSON _version GET "${manifest}" components ${_core_index} version)
      endif()
    endforeach()
    if(NOT _matches EQUAL 1 OR _version STREQUAL "")
      message(FATAL_ERROR "Verified core requires exactly one version for ${_component}")
    endif()
    string(JSON _variable GET "${CPKT_INVENTORY}" components "${_component}" package version_variable)
    set(${_variable} "${_version}" CACHE STRING "Version supplied by the verified pinned core SDK." FORCE)
  endforeach()
endmacro()

# Prerequisite imports only. This module never configures a core producer.
macro(cpkt_import_core)
  include("${CMAKE_SOURCE_DIR}/cmake/CpktPublishedCore.cmake")
  set(prefix "${CMAKE_SOURCE_DIR}/.cache/cpkt/${CPKT_TARGET_ID}/install")
  cpkt_validate_published_core("${CMAKE_SOURCE_DIR}" "${CPKT_TARGET_ID}" "${prefix}" core_manifest)
  string(JSON CPKT_CORE_PACKAGE_ID GET "${core_manifest}" package_id)
  cpkt_load_core_versions("${core_manifest}")
  set(CPKT_CORE_PREFIX "${prefix}" CACHE PATH "Verified pinned core installation." FORCE)
  string(JSON _core_version GET "${core_manifest}" release_version)
  list(APPEND CMAKE_PREFIX_PATH "${prefix}")
  list(APPEND CMAKE_FIND_ROOT_PATH "${prefix}")
  find_package(CpktCore ${_core_version} EXACT CONFIG REQUIRED)
  if(NOT CpktCore_PREFIX STREQUAL prefix OR
      NOT CpktCore_PACKAGE_ID STREQUAL CPKT_CORE_PACKAGE_ID OR
      NOT CpktCore_TARGET_ID STREQUAL CPKT_TARGET_ID)
    message(FATAL_ERROR "CpktCore discovery does not match the verified pinned prerequisite")
  endif()
  foreach(package IN ITEMS OpenSSL CpktOpenSSL ZLIB nghttp2 CpktNghttp2 libssh2 CpktLibssh2 CURL libxml2 Lua CpktLua CpktLuaRuntime mqtt-c CpktMqttc Kerberos5 CpktGssapi CyrusSASL CpktSasl OpenLDAP cmocka CpktCmocka)
    find_package(${package} CONFIG REQUIRED PATHS "${prefix}" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH)
  endforeach()
  if(NOT TARGET cpkt::openssl_crypto_static)
    add_library(cpkt::openssl_crypto_static ALIAS OpenSSL::Crypto)
  endif()
  if(NOT TARGET cpkt::openssl_ssl_static)
    add_library(cpkt::openssl_ssl_static ALIAS OpenSSL::SSL)
  endif()
  if(NOT TARGET cpkt::zlib_static)
    add_library(cpkt::zlib_static ALIAS ZLIB::ZLIB)
  endif()
  if(NOT TARGET cpkt::nghttp2_static)
    add_library(cpkt::nghttp2_static ALIAS nghttp2::nghttp2)
  endif()
  if(NOT TARGET cpkt::libssh2_static)
    add_library(cpkt::libssh2_static ALIAS libssh2::libssh2_static)
  endif()
  if(NOT TARGET cpkt::curl_static)
    add_library(cpkt::curl_static ALIAS CURL::libcurl)
  endif()
  if(NOT TARGET cpkt::libxml2_static)
    add_library(cpkt::libxml2_static ALIAS LibXml2::LibXml2)
  endif()
  if(NOT TARGET cpkt::lua_static)
    add_library(cpkt::lua_static ALIAS Lua::Lua)
  endif()
  if(NOT TARGET cpkt::mqttc_static)
    add_library(cpkt::mqttc_static ALIAS MQTT-C::mqttc)
  endif()
  if(NOT TARGET cpkt::cmocka)
    add_library(cpkt::cmocka ALIAS cpkt::cmocka_static)
  endif()
  string(JSON count LENGTH "${CPKT_INVENTORY}" components)
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON component MEMBER "${CPKT_INVENTORY}" components ${index})
    string(JSON external ERROR_VARIABLE absent GET "${CPKT_INVENTORY}" components "${component}" external)
    if(NOT absent)
      set_property(GLOBAL PROPERTY "CPKT_PRODUCER_TARGETS_${component}" "")
    endif()
  endforeach()
endmacro()
