include("${CMAKE_CURRENT_LIST_DIR}/CpktMutationPaths.cmake")
cpkt_validate_mutation_paths("${CPKT_OUTPUT}/exports.map" "${CPKT_OUTPUT}/exports.darwin")
file(STRINGS "${CPKT_CATALOG}" symbols)
if(NOT symbols)
  message(FATAL_ERROR "Empty generated facade export catalog: ${CPKT_CATALOG}")
endif()
set(elf "{\n  global:\n")
set(darwin "")
foreach(symbol IN LISTS symbols)
  if(NOT symbol MATCHES "^cpkt_[A-Za-z0-9_]+$")
    message(FATAL_ERROR "Invalid public facade symbol: ${symbol}")
  endif()
  string(APPEND elf "    ${symbol};\n")
  string(APPEND darwin "_${symbol}\n")
endforeach()
string(APPEND elf "  local: *;\n};\n")
file(WRITE "${CPKT_OUTPUT}/exports.map" "${elf}")
file(WRITE "${CPKT_OUTPUT}/exports.darwin" "${darwin}")
