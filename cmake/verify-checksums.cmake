cmake_minimum_required(VERSION 3.21)
file(STRINGS "${CPKT_MANIFEST}" lines)
set(found "")
foreach(line IN LISTS lines)
  if(NOT line MATCHES "^([a-f0-9]+)  (.+)$")
    message(FATAL_ERROR "Invalid checksum entry: ${line}")
  endif()
  set(expected "${CMAKE_MATCH_1}")
  set(name "${CMAKE_MATCH_2}")
  string(LENGTH "${expected}" length)
  if(NOT length EQUAL 64 OR NOT name IN_LIST CPKT_FILES OR name IN_LIST found)
    message(FATAL_ERROR "Unexpected/duplicate artifact: ${name}")
  endif()
  file(SHA256 "${CPKT_BASE}/${name}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Checksum mismatch: ${name}")
  endif()
  list(APPEND found "${name}")
endforeach()
list(SORT found)
list(SORT CPKT_FILES)
if(NOT found STREQUAL CPKT_FILES)
  message(FATAL_ERROR "Incomplete artifact manifest")
endif()
file(GLOB existing RELATIVE "${CPKT_BASE}" "${CPKT_BASE}/cpktmisc-*.tar.gz" "${CPKT_BASE}/cpktmisc-*.zip")
foreach(name IN LISTS existing)
  if(CPKT_SCOPE STREQUAL "binary")
    if(name STREQUAL "cpktmisc-${CPKT_VERSION}.tar.gz")
      continue()
    endif()
    # A warm binary rehearsal owns one version; preserve other releases.
    # Final release verification still rejects every unlisted archive below.
    if(name MATCHES "^cpktmisc-([0-9]+[.][0-9]+[.][0-9]+)(-|[.]tar[.]gz$)")
      if(NOT CMAKE_MATCH_1 STREQUAL CPKT_VERSION)
        continue()
      endif()
    endif()
  endif()
  if(NOT name IN_LIST CPKT_FILES)
    message(FATAL_ERROR "Stale/unlisted release-looking artifact: ${name}")
  endif()
endforeach()
