file(READ "${CPKT_MANIFEST}" manifest)
string(JSON id GET "${manifest}" package_id)
string(JSON core_pin GET "${manifest}" core_build_pin)
string(JSON core_requirement GET "${manifest}" requires_core)
string(JSON ids SET "{}" core_build_pin "${core_pin}")
string(JSON ids SET "${ids}" requires_core "${core_requirement}")
string(JSON ids SET "${ids}" misc "\"${id}\"")
file(WRITE "${CPKT_OUTPUT}" "${ids}")
