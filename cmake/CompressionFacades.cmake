include("${CMAKE_CURRENT_LIST_DIR}/CompressionFacadeGeneration.cmake")
foreach(library ffi archive zstd lzma lz4)
  set(native "${library}")
  if(library STREQUAL "ffi")
    set(native libffi)
  elseif(library STREQUAL "archive")
    set(native libarchive)
  elseif(library STREQUAL "lzma")
    set(native xz)
  endif()
  set(generated "${CMAKE_BINARY_DIR}/generated/${library}")
  string(TOUPPER "${library}" upper)
  foreach(kind static shared)
    string(TOUPPER "${kind}" type)
    set(target "cpkt_${library}_${kind}")
    cpkt_group_add_library(${target} ${type} "${generated}/src/${library}.c")
    add_dependencies(${target} cpkt_${library}_sources)
    target_include_directories(${target} PUBLIC
      "$<BUILD_INTERFACE:${generated}/include>" "$<BUILD_INTERFACE:${CMAKE_SOURCE_DIR}/include>"
      "$<INSTALL_INTERFACE:include>")
    set(backend "${kind}")
    if(library MATCHES "^(zstd|lz4)$")
      # Advanced/static declarations are absent from upstream shared exports.
      set(backend static)
    endif()
    target_link_libraries(${target} PRIVATE cpkt::${native}_${backend})
    if(library STREQUAL "ffi")
      target_link_libraries(${target} PRIVATE ${CMAKE_DL_LIBS})
    elseif(library MATCHES "^(archive|lzma|zstd)$")
      target_link_libraries(${target} PRIVATE Threads::Threads)
    endif()
    target_compile_options(${target} PRIVATE -std=c99 -Wno-deprecated-declarations)
    if(library STREQUAL "archive")
      target_compile_definitions(${target} PRIVATE _FILE_OFFSET_BITS=64)
    endif()
    cpkt_add_repo_warning_errors(${target})
    set_target_properties(${target} PROPERTIES OUTPUT_NAME "cpkt_${library}" POSITION_INDEPENDENT_CODE ON)
    if(kind STREQUAL "shared")
      set_target_properties(${target} PROPERTIES SOVERSION "${CPKT_${upper}_ABI_VERSION}" VERSION "${PROJECT_VERSION}")
      if(CMAKE_SYSTEM_NAME STREQUAL "Darwin")
        target_link_options(${target} PRIVATE "-Wl,-exported_symbols_list,${generated}/exports.darwin")
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${generated}/exports.darwin")
        set_target_properties(${target} PROPERTIES INSTALL_NAME_DIR "@rpath" BUILD_RPATH "@loader_path" INSTALL_RPATH "@loader_path" BUILD_WITH_INSTALL_RPATH ON)
      else()
        target_link_options(${target} PRIVATE "-Wl,--version-script,${generated}/exports.map" -Wl,--exclude-libs,ALL -Wl,--no-undefined)
        set_property(TARGET ${target} APPEND PROPERTY LINK_DEPENDS "${generated}/exports.map")
        set_target_properties(${target} PROPERTIES BUILD_RPATH "$ORIGIN" INSTALL_RPATH "$ORIGIN" BUILD_WITH_INSTALL_RPATH ON)
      endif()
    endif()
    if(CPKT_BUILD_TESTS)
      set(test "cpkt_${library}_facade_${kind}_test")
      cpkt_group_add_executable(${test} "tests/${library}_facade_test.c")
      target_link_libraries(${test} PRIVATE ${target})
      if(library STREQUAL "archive")
        target_link_libraries(${test} PRIVATE Threads::Threads)
      endif()
      cpkt_configure_c89_target(${test})
      cpkt_add_repo_warning_errors(${test})
      cpkt_group_use_local_runtime(${test} ${target})
      if(CPKT_CAN_RUN_TARGET_EXECUTABLES)
        cpkt_group_add_test(NAME ${library}_facade_${kind} COMMAND ${test})
        cpkt_group_set_tests_properties(${library}_facade_${kind} PROPERTIES LABELS "compression;facade;memcheck" TIMEOUT 60)
      endif()
    endif()
  endforeach()
  if(CPKT_BUILD_TESTS)
    set(layout "cpkt_${library}_layout_test")
    cpkt_group_add_executable(${layout} tests/compression_layout_test.c
      "${generated}/native_layout.c" "${generated}/public_layout.c")
    add_dependencies(${layout} cpkt_${library}_sources)
    target_include_directories(${layout} PRIVATE "${generated}/include" "${CMAKE_SOURCE_DIR}/include")
    target_include_directories(${layout} SYSTEM PRIVATE "${CPKT_EXTERNAL_ROOT}/${native}/install/include")
    target_compile_options(${layout} PRIVATE -std=c99)
    set_source_files_properties("${generated}/public_layout.c" PROPERTIES COMPILE_OPTIONS "-std=c89;-pedantic-errors")
    cpkt_add_repo_warning_errors(${layout})
    cpkt_group_use_local_runtime(${layout})
    if(CPKT_CAN_RUN_TARGET_EXECUTABLES)
      cpkt_group_add_test(NAME compression_layout_${library} COMMAND ${layout})
      cpkt_group_set_tests_properties(compression_layout_${library} PROPERTIES LABELS "compression;abi" TIMEOUT 30)
    endif()
    cpkt_group_add_test(NAME compression_api_${library}
      COMMAND "${CMAKE_COMMAND}" "-DCPKT_SOURCE=${CMAKE_SOURCE_DIR}" "-DCPKT_BINARY=${CMAKE_BINARY_DIR}"
        "-DCPKT_LIBRARY=${library}" "-DCPKT_CLANG=${CPKT_CODEC_GENERATOR_CLANG}"
        "-DCPKT_CLANG_ARGUMENTS=${CPKT_${upper}_CLANG_ARGUMENTS}"
        "-DCPKT_NATIVE_INCLUDE=${CPKT_EXTERNAL_ROOT}/${native}/install/include"
        "-DCPKT_SYSTEM=${CMAKE_SYSTEM_NAME}" "-DCPKT_NM=${CMAKE_NM}" "-DCPKT_STATIC=$<TARGET_FILE:cpkt_${library}_static>"
        "-DCPKT_SHARED=$<TARGET_FILE:cpkt_${library}_shared>"
        "-DCPKT_REPORT=${generated}/coverage.json" -P "${CMAKE_SOURCE_DIR}/tests/compression_api_test.cmake")
    cpkt_group_set_tests_properties(compression_api_${library} PROPERTIES LABELS "compression;api" TIMEOUT 60)
  endif()
endforeach()
if(CPKT_BUILD_TESTS)
  cpkt_group_add_test(NAME compression_api_contract COMMAND "${CMAKE_COMMAND}"
    "-DCPKT_SOURCE=${CMAKE_SOURCE_DIR}" "-DCPKT_BINARY=${CMAKE_BINARY_DIR}"
    -P "${CMAKE_SOURCE_DIR}/tests/compression_api_contract_test.cmake")
  cpkt_group_set_tests_properties(compression_api_contract PROPERTIES LABELS "compression;api" TIMEOUT 60)
  cpkt_group_add_test(NAME compression_metadata COMMAND "${CMAKE_COMMAND}"
    "-DCPKT_SOURCE=${CMAKE_SOURCE_DIR}" "-DCPKT_BINARY=${CMAKE_BINARY_DIR}"
    -P "${CMAKE_SOURCE_DIR}/tests/compression_metadata_test.cmake")
  cpkt_group_set_tests_properties(compression_metadata PROPERTIES LABELS "compression;packaging" TIMEOUT 60)
  cpkt_group_add_test(NAME linked_toolchain_probes COMMAND "${CMAKE_COMMAND}"
    "-DCPKT_BINARY=${CMAKE_BINARY_DIR}" "-DCPKT_TARGET=${CPKT_TARGET_ID}"
    -P "${CMAKE_SOURCE_DIR}/tests/linked_toolchain_probes_test.cmake")
  cpkt_group_set_tests_properties(linked_toolchain_probes PROPERTIES LABELS "compression;api" TIMEOUT 120)
  foreach(kind static shared)
    set(target "cpkt_native_codecs_${kind}_test")
    cpkt_group_add_executable(${target} tests/native_codecs_test.c)
    target_link_libraries(${target} PRIVATE cpkt::libyaml_${kind} cpkt::bzip2_${kind})
    cpkt_configure_c89_target(${target})
    cpkt_add_repo_warning_errors(${target})
    cpkt_group_use_local_runtime(${target} cpkt::libyaml_${kind} cpkt::bzip2_${kind})
    if(CPKT_CAN_RUN_TARGET_EXECUTABLES)
      cpkt_group_add_test(NAME native_codecs_${kind} COMMAND ${target})
      cpkt_group_set_tests_properties(native_codecs_${kind} PROPERTIES LABELS "compression;memcheck" TIMEOUT 60)
    endif()
  endforeach()
  foreach(library yaml bzip2)
    set(native "${library}")
    if(library STREQUAL "yaml")
      set(native libyaml)
    endif()
    cpkt_group_add_test(NAME compression_api_${library}
      COMMAND "${CMAKE_COMMAND}" "-DCPKT_SOURCE=${CMAKE_SOURCE_DIR}" "-DCPKT_BINARY=${CMAKE_BINARY_DIR}"
        "-DCPKT_LIBRARY=${library}" "-DCPKT_CLANG=${CPKT_CODEC_GENERATOR_CLANG}"
        "-DCPKT_CLANG_ARGUMENTS=${CPKT_FFI_CLANG_ARGUMENTS}"
        "-DCPKT_NATIVE_INCLUDE=${CPKT_EXTERNAL_ROOT}/${native}/install/include"
        "-DCPKT_SYSTEM=${CMAKE_SYSTEM_NAME}" "-DCPKT_NM=${CMAKE_NM}" "-DCPKT_STATIC=$<TARGET_FILE:cpkt::${native}_static>"
        "-DCPKT_SHARED=$<TARGET_FILE:cpkt::${native}_shared>"
        -P "${CMAKE_SOURCE_DIR}/tests/compression_api_test.cmake")
    cpkt_group_set_tests_properties(compression_api_${library} PROPERTIES LABELS "compression;api" TIMEOUT 60)
  endforeach()
endif()
