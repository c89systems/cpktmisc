include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/Validate.cmake")
get_filename_component(_cpkt_misc_install "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
_cpkt_misc_validate_prefix("${_cpkt_misc_install}" misc)
file(READ "${_cpkt_misc_install}/share/cpkt/packages/misc.json" _cpkt_misc_manifest)

string(JSON _cpkt_misc_core_version GET "${_cpkt_misc_manifest}" requires_core release_version)
find_dependency(CpktCore ${_cpkt_misc_core_version} EXACT CONFIG REQUIRED)
foreach(_cpkt_misc_field package_id release_version target_id)
  string(JSON _cpkt_misc_expected GET "${_cpkt_misc_manifest}" requires_core "${_cpkt_misc_field}")
  if(_cpkt_misc_field STREQUAL package_id)
    set(_cpkt_misc_actual "${CpktCore_PACKAGE_ID}")
  elseif(_cpkt_misc_field STREQUAL release_version)
    set(_cpkt_misc_actual "${CpktCore_VERSION}")
  else()
    set(_cpkt_misc_actual "${CpktCore_TARGET_ID}")
  endif()
  if(NOT _cpkt_misc_expected STREQUAL _cpkt_misc_actual)
    message(FATAL_ERROR "cpktmisc core prerequisite mismatch: ${_cpkt_misc_field}")
  endif()
endforeach()
if(CpktCore_PREFIX STREQUAL _cpkt_misc_install)
  message(FATAL_ERROR "cpkt and cpktmisc require separate installation prefixes")
endif()
set(CpktMisc_FOUND TRUE)
string(JSON CpktMisc_VERSION GET "${_cpkt_misc_manifest}" release_version)
