include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/Validate.cmake")
get_filename_component(_cpkt_misc_install "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
_cpkt_misc_validate_prefix("${_cpkt_misc_install}" misc)
file(READ "${_cpkt_misc_install}/share/cpkt/packages/misc.json" _cpkt_misc_manifest)

string(JSON _cpkt_misc_core_version GET "${_cpkt_misc_manifest}" requires_core release_version)
if(NOT _cpkt_misc_core_version MATCHES "^[0-9]+[.][0-9]+[.][0-9]+$")
  message(FATAL_ERROR "Invalid cpktmisc core compatibility baseline")
endif()
find_dependency(CpktCore ${_cpkt_misc_core_version} CONFIG REQUIRED)
if(NOT CpktCore_COMPATIBLE_SINCE MATCHES "^[0-9]+[.][0-9]+[.][0-9]+$"
    OR CpktCore_VERSION VERSION_LESS _cpkt_misc_core_version
    OR CpktCore_COMPATIBLE_SINCE VERSION_GREATER _cpkt_misc_core_version)
  message(FATAL_ERROR "cpktmisc core compatibility baseline is outside the selected core span")
endif()
string(JSON _cpkt_misc_core_target GET "${_cpkt_misc_manifest}" requires_core target_id)
string(JSON _cpkt_misc_target GET "${_cpkt_misc_manifest}" target_id)
if(NOT _cpkt_misc_core_target STREQUAL CpktCore_TARGET_ID
    OR NOT _cpkt_misc_target STREQUAL CpktCore_TARGET_ID)
  message(FATAL_ERROR "cpktmisc core prerequisite mismatch: target_id")
endif()
if(CpktCore_PREFIX STREQUAL _cpkt_misc_install)
  message(FATAL_ERROR "cpkt and cpktmisc require separate installation prefixes")
endif()
set(CpktMisc_FOUND TRUE)
string(JSON CpktMisc_VERSION GET "${_cpkt_misc_manifest}" release_version)
