include(CMakeFindDependencyMacro)
include("${CMAKE_CURRENT_LIST_DIR}/Validate.cmake")
get_filename_component(_cpkt_misc_install "${CMAKE_CURRENT_LIST_DIR}/../../.." REALPATH)
_cpkt_misc_validate_prefix("${_cpkt_misc_install}" misc)
file(READ "${_cpkt_misc_install}/share/cpkt/packages/misc.json" _cpkt_misc_manifest)

# OpenSSL is an existing public entry point in the pinned published core SDK.
# Its config validates core's bytes and targets in core's own installation.
find_dependency(OpenSSL CONFIG REQUIRED)
get_filename_component(_cpkt_misc_core "${OpenSSL_DIR}/../../.." REALPATH)
set(_cpkt_misc_core_manifest "${_cpkt_misc_core}/share/cpkt/packages/core.json")
if(NOT EXISTS "${_cpkt_misc_core_manifest}" OR IS_SYMLINK "${_cpkt_misc_core_manifest}")
  message(FATAL_ERROR "cpktmisc requires the pinned published cpkt core SDK; resolved OpenSSL has no core manifest")
endif()
_cpkt_misc_validate_prefix("${_cpkt_misc_core}" core)
file(READ "${_cpkt_misc_core_manifest}" _cpkt_misc_supplied_core)
foreach(_cpkt_misc_field package_id release_version target_id)
  string(JSON _cpkt_misc_expected GET "${_cpkt_misc_manifest}" requires_core "${_cpkt_misc_field}")
  string(JSON _cpkt_misc_actual GET "${_cpkt_misc_supplied_core}" "${_cpkt_misc_field}")
  if(NOT _cpkt_misc_expected STREQUAL _cpkt_misc_actual)
    message(FATAL_ERROR "cpktmisc core prerequisite mismatch: ${_cpkt_misc_field}")
  endif()
endforeach()
if(_cpkt_misc_core STREQUAL _cpkt_misc_install)
  message(FATAL_ERROR "cpkt and cpktmisc require separate installation prefixes")
endif()
set(CpktMisc_FOUND TRUE)
string(JSON CpktMisc_VERSION GET "${_cpkt_misc_manifest}" release_version)
