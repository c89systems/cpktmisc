include("${CMAKE_CURRENT_LIST_DIR}/CpktMutationPaths.cmake")
# Compose acquired payloads in owned scratch; installed validation checks bytes.
function(cpkt_compose_sdk core optional destination reverse)
  cpkt_validate_mutation_paths("${destination}")
  set(owned "")
  foreach(pair "${core}|core" "${optional}|misc")
    string(REPLACE "|" ";" pair "${pair}")
    list(GET pair 0 prefix)
    list(GET pair 1 owner)
    file(READ "${prefix}/share/cpkt/packages/${owner}.json" manifest)
    string(JSON count LENGTH "${manifest}" files)
    if(count LESS 1)
      message(FATAL_ERROR "Empty ${owner} SDK payload")
    endif()
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
      string(JSON path GET "${manifest}" files ${index} path)
      if(path IN_LIST owned)
        message(FATAL_ERROR "SDK payload collision: ${path}")
      endif()
      list(APPEND owned "${path}")
    endforeach()
  endforeach()
  file(REMOVE_RECURSE "${destination}")
  file(MAKE_DIRECTORY "${destination}")
  if(reverse)
    set(prefixes "${optional}" "${core}")
  else()
    set(prefixes "${core}" "${optional}")
  endif()
  foreach(prefix IN LISTS prefixes)
    file(COPY "${prefix}/" DESTINATION "${destination}")
  endforeach()
endfunction()
