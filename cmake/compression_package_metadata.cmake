# Relocatable native and facade discovery. Upstream ABI filenames are retained.
function(cpkt_codec_metadata package component library version alias requirements static_links shared_links)
  set(directory "${_stage_root}/lib/cmake/${package}")
  set(config "include(CMakeFindDependencyMacro)\nfind_dependency(Threads REQUIRED)\n")
  foreach(requirement IN LISTS requirements)
    string(APPEND config "find_dependency(${requirement} CONFIG REQUIRED)\n")
  endforeach()
  string(APPEND config
    "get_filename_component(_cpkt_codec_prefix \"\${CMAKE_CURRENT_LIST_DIR}/../../..\" ABSOLUTE)\n"
    "set(${package}_VERSION \"${version}\")\nset(${package}_FOUND TRUE)\n")
  foreach(kind static shared)
    if(kind STREQUAL "static")
      set(suffix "${_cpkt_static_library_suffix}")
      set(type STATIC)
      set(links "${static_links}")
    else()
      set(suffix "${_cpkt_shared_library_suffix}")
      set(type SHARED)
      set(links "${shared_links}")
    endif()
    set(target "cpkt::${component}_${kind}")
    string(APPEND config "if(NOT TARGET ${target})\n  add_library(${target} ${type} IMPORTED)\n"
      "  set_target_properties(${target} PROPERTIES\n"
      "    IMPORTED_LOCATION \"\${_cpkt_codec_prefix}/lib/lib${library}${suffix}\"\n"
      "    INTERFACE_INCLUDE_DIRECTORIES \"\${_cpkt_codec_prefix}/include\"\n"
      "    INTERFACE_LINK_LIBRARIES \"${links}\")\nendif()\n")
    if(component STREQUAL "libarchive")
      string(APPEND config "set_property(TARGET ${target} PROPERTY INTERFACE_COMPILE_DEFINITIONS _FILE_OFFSET_BITS=64)\n")
    endif()
  endforeach()
  string(APPEND config "if(NOT TARGET ${alias})\n  add_library(${alias} ALIAS cpkt::${component}_static)\nendif()\n")
  if(package STREQUAL "zstd")
    string(APPEND config "if(NOT TARGET zstd::libzstd_shared)\n  add_library(zstd::libzstd_shared ALIAS cpkt::zstd_native_shared)\nendif()\n")
  endif()
  cpkt_metadata_file(MAKE_DIRECTORY "${directory}")
  cpkt_metadata_file(WRITE "${directory}/${package}Config.cmake" "${config}")
  cpkt_write_config_version("${package}" "${package}" "${version}")
endfunction()

cpkt_codec_metadata(CpktFfi libffi ffi "${CPKT_LIBFFI_VERSION}" CpktFfi::Ffi "" "Threads::Threads;${CMAKE_DL_LIBS}" "Threads::Threads;${CMAKE_DL_LIBS}")
cpkt_codec_metadata(CpktYaml libyaml yaml "${CPKT_LIBYAML_VERSION}" CpktYaml::Yaml "" "" "")
cpkt_codec_metadata(CpktBzip2 bzip2 bz2 "${CPKT_BZIP2_VERSION}" BZip2::BZip2 "" "" "")
cpkt_codec_metadata(CpktLzma xz lzma "${CPKT_XZ_VERSION}" LibLZMA::LibLZMA "" Threads::Threads Threads::Threads)
cpkt_codec_metadata(CpktLz4 lz4_native lz4 "${CPKT_LZ4_VERSION}" LZ4::LZ4 "" "" "")
cpkt_codec_metadata(zstd zstd_native zstd "${CPKT_ZSTD_VERSION}" zstd::libzstd_static "" Threads::Threads Threads::Threads)
cpkt_codec_metadata(LibArchive libarchive archive "${CPKT_LIBARCHIVE_VERSION}" LibArchive::LibArchive
  "CpktBzip2;CpktLzma;CpktLz4;zstd;ZLIB;OpenSSL;libxml2"
  "cpkt::bzip2_static;cpkt::xz_static;cpkt::lz4_native_static;cpkt::zstd_native_static;ZLIB::ZLIB;OpenSSL::SSL;OpenSSL::Crypto;LibXml2::LibXml2;Threads::Threads"
  "cpkt::bzip2_shared;cpkt::xz_shared;cpkt::lz4_native_shared;cpkt::zstd_native_shared;cpkt::zlib_shared;cpkt::openssl_ssl_shared;cpkt::openssl_crypto_shared;cpkt::libxml2_shared;Threads::Threads")

foreach(library ffi archive zstd lzma lz4)
  set(component "${library}")
  set(package "Cpkt${library}Facade")
  if(library STREQUAL "ffi")
    set(component libffi)
    set(package CpktFfiFacade)
    set(native_package CpktFfi)
  elseif(library STREQUAL "archive")
    set(component libarchive)
    set(package CpktArchiveFacade)
    set(native_package LibArchive)
  elseif(library STREQUAL "lzma")
    set(component xz)
    set(package CpktLzmaFacade)
    set(native_package CpktLzma)
  elseif(library STREQUAL "lz4")
    set(package CpktLz4Facade)
    set(native_package CpktLz4)
  else()
    set(package CpktZstdFacade)
    set(native_package zstd)
  endif()
  if(library MATCHES "^(zstd|lz4)$")
    set(component "${library}_native")
  endif()
  set(static_links "cpkt::${component}_static")
  set(shared_links "cpkt::${component}_shared")
  if(library MATCHES "^(zstd|lz4)$")
    set(shared_links "")
  endif()
  if(library MATCHES "^(ffi|archive|zstd|lzma)$")
    string(APPEND static_links ";Threads::Threads")
    string(APPEND shared_links ";Threads::Threads")
  endif()
  if(library STREQUAL "ffi")
    string(APPEND static_links ";${CMAKE_DL_LIBS}")
    string(APPEND shared_links ";${CMAKE_DL_LIBS}")
  endif()
  cpkt_codec_metadata("${package}" "${library}" "cpkt_${library}" "${CPKT_BUNDLE_VERSION}"
    "cpkt::${library}" "${native_package}" "${static_links}" "${shared_links}")
endforeach()

function(cpkt_codec_pc package library version requirements private_requirements private_libraries)
  set(flags "")
  if(package STREQUAL "libarchive")
    set(flags " -D_FILE_OFFSET_BITS=64")
  endif()
  cpkt_metadata_file(WRITE "${_stage_root}/lib/pkgconfig/${package}.pc"
    "prefix=\${pcfiledir}/../..\nlibdir=\${prefix}/lib\nincludedir=\${prefix}/include\n"
    "Name: ${package}\nDescription: Bundled ${package} public API\nVersion: ${version}\n"
    "Requires: ${requirements}\nRequires.private: ${private_requirements}\n"
    "Libs: -L\${libdir} -l${library}\nLibs.private: ${private_libraries}\nCflags: -I\${includedir}${flags}\n")
endfunction()
if(CPKT_TARGET_ID MATCHES "darwin$")
  set(codec_threads "")
  set(codec_dl "")
else()
  set(codec_threads -pthread)
  set(codec_dl -ldl)
endif()
cpkt_codec_pc(libffi ffi "${CPKT_LIBFFI_VERSION}" "" "" "${codec_threads} ${codec_dl}")
cpkt_codec_pc(yaml-0.1 yaml "${CPKT_LIBYAML_VERSION}" "" "" "")
cpkt_codec_pc(bzip2 bz2 "${CPKT_BZIP2_VERSION}" "" "" "")
cpkt_codec_pc(liblzma lzma "${CPKT_XZ_VERSION}" "" "" "${codec_threads}")
cpkt_codec_pc(liblz4 lz4 "${CPKT_LZ4_VERSION}" "" "" "")
cpkt_codec_pc(libzstd zstd "${CPKT_ZSTD_VERSION}" "" "" "${codec_threads}")
cpkt_codec_pc(libarchive archive "${CPKT_LIBARCHIVE_VERSION}"
  "bzip2 liblzma liblz4 libzstd zlib openssl libxml-2.0" "" "${codec_threads}")
foreach(library ffi archive zstd lzma lz4)
  set(requirement "lib${library}")
  if(library STREQUAL "lzma")
    set(requirement liblzma)
  endif()
  set(public "")
  set(private "${requirement}")
  if(library MATCHES "^(ffi|archive|lzma)$")
    set(public "${requirement}")
    set(private "")
  endif()
  set(system "")
  if(library MATCHES "^(ffi|archive|zstd|lzma)$")
    set(system "${codec_threads}")
  endif()
  cpkt_codec_pc("cpkt-${library}" "cpkt_${library}" "${CPKT_BUNDLE_VERSION}" "${public}" "${private}" "${system}")
endforeach()
