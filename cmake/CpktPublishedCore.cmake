include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/CpktMiscValidate.cmake")

# Published SDK pins are the only core prerequisite; acquisition is explicit.
function(cpkt_core_pin root target output)
  if(NOT target MATCHES "^(x86_64|aarch64|armhf)-linux-(gnu|musl)$|^arm64-apple-darwin$")
    message(FATAL_ERROR "Unsupported imported core target: ${target}")
  endif()
  file(READ "${root}/dependencies/cpkt.json" pin)
  string(JSON schema GET "${pin}" schema_version)
  string(JSON repository GET "${pin}" repository)
  string(JSON version GET "${pin}" version)
  if(NOT schema EQUAL 1 OR NOT repository STREQUAL "c89systems/cpkt"
      OR NOT version MATCHES "^[0-9]+[.][0-9]+[.][0-9]+$")
    message(FATAL_ERROR "Invalid dependencies/cpkt.json provider/version")
  endif()
  string(JSON selected ERROR_VARIABLE missing GET "${pin}" targets "${target}")
  if(missing)
    message(FATAL_ERROR "Core ${version} has no published checksum pin for ${target}")
  endif()
  set(name "cpkt-${version}-${target}.tar.gz")
  string(JSON url GET "${selected}" url)
  if(NOT url STREQUAL "https://github.com/c89systems/cpkt/releases/download/v${version}/${name}")
    message(FATAL_ERROR "Invalid published core archive URL for ${target}")
  endif()
  foreach(field sha256 package_id)
    string(JSON value GET "${selected}" "${field}")
    string(LENGTH "${value}" length)
    if(NOT length EQUAL 64 OR NOT value MATCHES "^[a-f0-9]+$")
      message(FATAL_ERROR "Invalid core ${field} for ${target}")
    endif()
  endforeach()
  string(JSON selected SET "${selected}" version "\"${version}\"")
  string(JSON selected SET "${selected}" name "\"${name}\"")
  set(${output} "${selected}" PARENT_SCOPE)
endfunction()

function(cpkt_validate_published_core root target prefix output)
  cpkt_core_pin("${root}" "${target}" pin)
  # Validate the selected SDK independently of the workstation's platform.
  set(CPKT_TARGET_ID "${target}")
  string(JSON CPKT_EXPECTED_VERSION GET "${pin}" version)
  set(CMAKE_SYSTEM_NAME "")
  set(CMAKE_SYSTEM_PROCESSOR "")
  _cpkt_misc_validate_prefix("${prefix}" core)
  file(READ "${prefix}/share/cpkt/packages/core.json" manifest)
  string(JSON expected GET "${pin}" package_id)
  string(JSON actual GET "${manifest}" package_id)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Published core package ID does not match dependencies/cpkt.json")
  endif()
  set(${output} "${manifest}" PARENT_SCOPE)
endfunction()
