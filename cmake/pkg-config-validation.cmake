cmake_minimum_required(VERSION 3.21)
project(cpktmisc_pkg_config_validation NONE)
if(NOT CPKT_SDK_PREFIX)
  message(FATAL_ERROR "CPKT_SDK_PREFIX must select an independent misc SDK")
endif()
# The launcher uses pkg-config's environment, not CMake's prefix additions.
find_package(PkgConfig REQUIRED)
pkg_check_modules(CPKT_CORE REQUIRED NO_CMAKE_PATH NO_CMAKE_ENVIRONMENT_PATH cpkt-core)
if(NOT CPKT_CORE_PREFIX)
  message(FATAL_ERROR "cpkt-core must be discoverable through PKG_CONFIG_PATH")
endif()
# Validate the selected target, including cross SDKs, without compiling probes.
set(CMAKE_SYSTEM_NAME "")
set(CMAKE_SYSTEM_PROCESSOR "")
file(READ "${CPKT_SDK_PREFIX}/share/cpkt/packages/misc.json" manifest)
string(JSON CPKT_TARGET_ID GET "${manifest}" target_id)
set(CpktMisc_DIR "${CPKT_SDK_PREFIX}/lib/cmake/CpktMisc")
set(CpktCore_DIR "${CPKT_CORE_PREFIX}/lib/cmake/CpktCore")
list(PREPEND CMAKE_PREFIX_PATH "${CPKT_CORE_PREFIX}")
find_package(CpktMisc CONFIG REQUIRED)
file(REAL_PATH "${CPKT_CORE_PREFIX}" selected_core)
if(NOT CpktCore_PREFIX STREQUAL selected_core)
  message(FATAL_ERROR "pkg-config selected a different core SDK from CMake")
endif()
